#. IDS_PLUGIN_DESCRIPTION9
#: Strings.rc:123
msgid ""
"Replace text.\r\n"
"Usage: Replace [-i] [-e] FIND REPLACE\r\n"
" or: Replace -s\r\n"
" FIND - text to find\r\n"
" REPLACE - text to replace\r\n"
" -i - ignore case (only for -e)\r\n"
" -e - regex\r\n"
" -s - use Substitution Filters"
msgstr ""
"取代文字。\r\n"
"用法：Replace [-i] [-e] FIND REPLACE\r\n"
"或：Replace -s\r\n"
"FIND - 要尋找的文字\r\n"
"REPLACE - 要取代的文字\r\n"
"-i - 忽略大小寫（僅適用於 -e）\r\n"
"-e - 正規表達式\r\n"
"-s - 使用替換篩選器"

#: Strings.rc:125
#, c-format
msgid ""
"Apply filter. \r\n"
"Usage: ExecFilterCommand COMMAND\r\n"
" COMMAND - command to execute. %1 = filename."
msgstr ""
"應用篩選器。\r\n"
"用法：ExecFilterCommand COMMAND\r\n"
" COMMAND - 要執行的命令。%1 = 檔名。"

#: Strings.rc:127
msgid ""
"Tokenize. \r\n"
"Usage: Tokenize PATTERNS\r\n"
" PATTERNS - regex (e.g. [^\\w]+)"
msgstr ""
"選取的文字進行分詞 (Tokenize)。\r\n"
"用法：Tokenize PATTERNS\r\n"
" PATTERNS - 用於分詞的正規表達式。（例如：[^\\w]+）"

#. IDS_PLUGIN_DESCRIPTION12
#: Strings.rc:128
msgid "Trim spaces"
msgstr "修剪空格"

#: Strings.rc:130
msgid ""
"Select columns.\r\n"
"Usage: SelectColumns RANGES\r\n"
" or: SelectColumns [-v] [-i] [-g] -e PATTERNS\r\n"
" or: SelectColumns [-v] [-i] -F STRING\r\n"
" RANGES - column ranges (-3,5-10,30-)\r\n"
" PATTERNS - regex\r\n"
" STRING - string to match literally\r\n"
" -v - select non-matching\r\n"
" -i - ignore case\r\n"
" -g - enable global flag\r\n"
" -e - use PATTERNS\r\n"
" -F - use fixed string for matching"
msgstr ""
"選取欄位。\n"
"用法：SelectColumns RANGES\n"
" 或：SelectColumns [-v] [-i] [-g] -e PATTERNS\n"
" 或：SelectColumns [-v] [-i] -F STRING\n"
" RANGES - 欄位範圍 (-3,5-10,30-)\n"
" PATTERNS - 正規表達式\n"
" STRING - 要逐字匹配的字串\n"
" -v - 選取不一致項\n"
" -i - 忽略大小寫\n"
" -g - 啟用全域旗標\n"
" -e - 使用 PATTERNS\n"
" -F - 使用固定字串進行匹配"

#: Strings.rc:132
msgid ""
"Select lines.\r\n"
"Usage: SelectLines RANGES\r\n"
" or: SelectLines [-v] [-i] -e PATTERNS\r\n"
" or: SelectLines [-v] [-i] -F STRING\r\n"
" RANGES - line ranges (-3,5-10,30-)\r\n"
" PATTERNS - regex\r\n"
" STRING - string to match literally\r\n"
" -v - select non-matching\r\n"
" -i - ignore case\r\n"
" -e - use PATTERNS\r\n"
" -F - use fixed string for matching"
msgstr ""
"選取行。\n"
"用法：SelectLines RANGES\n"
" 或：SelectLines [-v] [-i] -e PATTERNS\n"
" 或：SelectLines [-v] [-i] -F STRING\n"
" RANGES - 行範圍 (-3,5-10,30-)\n"
" PATTERNS - 正規表達式\n"
" STRING - 要逐字匹配的字串\n"
" -v - 選取不一致項\n"
" -i - 忽略大小寫\n"
" -e - 使用 PATTERNS\n"
" -F - 使用固定字串進行匹配"

