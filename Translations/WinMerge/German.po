#. IDS_PLUGIN_DESCRIPTION9
#: Strings.rc:123
msgid ""
"Replace text.\r\n"
"Usage: Replace [-i] [-e] FIND REPLACE\r\n"
" or: Replace -s\r\n"
" FIND - text to find\r\n"
" REPLACE - text to replace\r\n"
" -i - ignore case (only for -e)\r\n"
" -e - regex\r\n"
" -s - use Substitution Filters"
msgstr ""
"Text durch einen anderen Text ersetzen.\r\n"
"Verwendung: Replace [-i] [-e] FIND REPLACE\r\n"
"  or: Replace -s\r\n"
"  FIND - zu suchender Text\r\n"
"  REPLACE - zu ersetzender Text\r\n"
"  -i - Groß-/Kleinschreibung ignorieren (nur für -e)\r\n"
"  -e - den angegebenen Text als regulären Ausdruck behandeln\r\n"
" -s - use Substitution Filters"

#: Strings.rc:125
#, c-format
msgid ""
"Apply filter. \r\n"
"Usage: ExecFilterCommand COMMAND\r\n"
" COMMAND - command to execute. %1 = filename."
msgstr ""
"Filterbefehl anwenden. \r\n"
"Verwendung: ExecFilterCommand COMMAND\r\n"
"  COMMAND - auszuführender Befehl. %1 im Befehl wird durch den Dateinamen ersetzt."

#: Strings.rc:127
msgid ""
"Tokenize. \r\n"
"Usage: Tokenize PATTERNS\r\n"
" PATTERNS - regex (e.g. [^\\w]+)"
msgstr ""
"Auswahl tokenisieren. \r\n"
"Verwendung: Tokenize PATTERNS\r\n"
"  PATTERNS - regulärer Ausdruck für die Tokenisierung (z. B. [^\\w]+)."

#. IDS_PLUGIN_DESCRIPTION12
#: Strings.rc:128
msgid "Trim spaces"
msgstr "Leerzeichen kürzen"

#: Strings.rc:130
msgid ""
"Select columns.\r\n"
"Usage: SelectColumns RANGES\r\n"
" or: SelectColumns [-v] [-i] [-g] -e PATTERNS\r\n"
" or: SelectColumns [-v] [-i] -F STRING\r\n"
" RANGES - column ranges (-3,5-10,30-)\r\n"
" PATTERNS - regex\r\n"
" STRING - string to match literally\r\n"
" -v - select non-matching\r\n"
" -i - ignore case\r\n"
" -g - enable global flag\r\n"
" -e - use PATTERNS\r\n"
" -F - use fixed string for matching"
msgstr ""
"Spalten auswählen.\r\n"
"Verwendung: SelectColumns RANGES\r\n"
" oder: SelectColumns [-v] [-i] [-g] -e PATTERNS\r\n"
" oder: SelectColumns [-v] [-i] -F STRING\r\n"
" RANGES - Spaltenbereiche (-3,5-10,30-)\r\n"
" PATTERNS - regulärer Ausdruck\r\n"
" STRING - Zeichenfolge, die wörtlich abgeglichen werden soll\r\n"
" -v - Nicht übereinstimmende Spalten auswählen\r\n"
" -i - Groß-/Kleinschreibung ignorieren\r\n"
" -g - Globales Flag aktivieren\r\n"
" -e - PATTERNS verwenden\r\n"
" -F - Feste Zeichenfolge für den Abgleich verwenden"

#: Strings.rc:132
msgid ""
"Select lines.\r\n"
"Usage: SelectLines RANGES\r\n"
" or: SelectLines [-v] [-i] -e PATTERNS\r\n"
" or: SelectLines [-v] [-i] -F STRING\r\n"
" RANGES - line ranges (-3,5-10,30-)\r\n"
" PATTERNS - regex\r\n"
" STRING - string to match literally\r\n"
" -v - select non-matching\r\n"
" -i - ignore case\r\n"
" -e - use PATTERNS\r\n"
" -F - use fixed string for matching"
msgstr ""
"Zeilen auswählen.\r\n"
"Verwendung: SelectLines RANGES\r\n"
" oder: SelectLines [-v] [-i] -e PATTERNS\r\n"
" oder: SelectLines [-v] [-i] -F STRING\r\n"
" RANGES - Zeilenbereiche (-3,5-10,30-)\r\n"
" PATTERNS - regulärer Ausdruck\r\n"
" STRING - Zeichenfolge, die wörtlich abgeglichen werden soll\r\n"
" -v - Nicht übereinstimmende Zeilen auswählen\r\n"
" -i - Groß-/Kleinschreibung ignorieren\r\n"
" -e - PATTERNS verwenden\r\n"
" -F - Feste Zeichenfolge für den Abgleich verwenden"

