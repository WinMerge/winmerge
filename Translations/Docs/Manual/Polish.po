msgid ""
"<command>Tokenize</command> <arg rep=\"norepeat\"><replaceable>patterns</"
"replaceable></arg>"
msgstr ""
"<command>Tokenize</command> <arg rep=\"norepeat\"><replaceable>patterns</"
"replaceable></arg>"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Plugins.xml:2491
msgid "regular expression for tokenizing. (e.g. [^\\w]+)"
msgstr "wyrażenie regularne do tokenizacji. (np. [^\\w]+)"

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2529
msgid "Trim plugin file"
msgstr "Przytnij plik wtyczki"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2528
msgid "<filename>Trim<placeholder type=\"indexterm\" id=\"0\"/></filename>"
msgstr "<filename>Trim<placeholder type=\"indexterm\" id=\"0\"/></filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2532
msgid "Trim spaces"
msgstr "Przytnij spacje"

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2566
msgid "IgnoreColumns plugin file"
msgstr "Plik wtyczki IgnoreColumns"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2565
msgid ""
"<filename>IgnoreColumns<placeholder type=\"indexterm\" id=\"0\"/></filename>"
msgstr ""
"<filename>IgnoreColumns<placeholder type=\"indexterm\" id=\"0\"/></filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2569
msgid ""
"This plugin ignores characters at specified columns. The first column is "
"number 1."
msgstr ""
"Ta wtyczka ignoruje znaki w określonych kolumnach. Pierwsza kolumna ma numer "
"1."

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2572
msgid ""
"Note that this plugin does not support files with tabs: the plugin does not "
"fail, but all tabs are be treated as normal characters."
msgstr ""
"Pamiętaj, że ta wtyczka nie obsługuje plików z tabulatorami: wtyczka nie "
"zawodzi, ale wszystkie tabulatory są traktowane jak normalne znaki."

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2575
msgid ""
"To specify columns, use plugin settings dialog or rename the <filename>dll</"
"filename> using following fields as parameters:"
msgstr ""
"Aby określić kolumny, użyj okna ustawień wtyczki lub zmień nazwę "
"<filename>dll</filename> używając następujących pól jako parametrów:"

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2580
msgid "Delimiters between ranges: _ or ,"
msgstr "Separatory pomiędzy zakresami: _ lub ,"

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2584
msgid "Delimiters between min and max: <emphasis>anything else</emphasis>"
msgstr ""
"Ograniczniki między wartością minimalną i maksymalną: <emphasis>cokolwiek "
"innego</emphasis>"

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2589
msgid "Min and max are included."
msgstr "Min. i maks. są uwzględnione."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2593
msgid "When max = min, max can be omitted."
msgstr "Gdy max = min, max można pominąć."

#. type: Content of: <article><section><section><example><title>
#: English/Plugins.xml:2598
msgid "<filename>IgnoreColumns</filename> examples"
msgstr "<filename>IgnoreColumns</filename> przykłady"

#. type: Content of: <article><section><section><example><variablelist><varlistentry><term>
#: English/Plugins.xml:2602
msgid "<filename>IgnoreColumns _ 3 _ 10 - 20 _ 32 - 33.dll</filename>"
msgstr "<filename>IgnoreColumns _ 3 _ 10 - 20 _ 32 - 33.dll</filename>"

#. type: Content of: <article><section><section><example><variablelist><varlistentry><listitem><simpara>
#: English/Plugins.xml:2606
msgid ""
"Ignore all characters at column 3, and in columns 10 to 20, and 32 to 33."
msgstr ""
"Zignoruj wszystkie znaki w kolumnie 3 oraz w kolumnach od 10 do 20 i od 32 "
"do 33."

#. type: Content of: <article><section><section><example><variablelist><varlistentry><term>
#: English/Plugins.xml:2612
msgid "<filename>IgnoreColumns_1,30 to 40.dll</filename>"
msgstr "<filename>IgnoreColumns_1,30 to 40.dll</filename>"

#. type: Content of: <article><section><section><example><variablelist><varlistentry><listitem><simpara>
#: English/Plugins.xml:2615
msgid "Ignore all the characters in column 1, and in columns 30 to 40."
msgstr "Zignoruj wszystkie znaki w kolumnie 1 i kolumnach od 30 do 40."

#. type: Content of: <article><section><section><example>
#: English/Plugins.xml:2600
msgid "<placeholder type=\"variablelist\" id=\"0\"/>"
msgstr "<placeholder type=\"variablelist\" id=\"0\"/>"

#. type: Content of: <article><section><section><para><segmentedlist><seglistitem><seg>
#: English/Plugins.xml:2632 English/Plugins.xml:2660 English/Plugins.xml:2702
#: English/Plugins.xml:2737 English/Plugins.xml:2768
msgid "Prediffer"
msgstr "Preferuj"

#. type: Content of: <article><section><section><para><segmentedlist><seglistitem><seg>
#: English/Plugins.xml:2634 English/Plugins.xml:2739
msgid "<filename class=\"extension\">*.txt</filename>"
msgstr "<filename class=\"extension\">*.txt</filename>"

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2643
msgid "IgnoreCommentsC plugin file"
msgstr "Plik wtyczki IgnoreCommentsC"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2642
msgid ""
"<filename>IgnoreCommentsC<placeholder type=\"indexterm\" id=\"0\"/></"
"filename>"
msgstr ""
"<filename>IgnoreCommentsC<placeholder type=\"indexterm\" id=\"0\"/></"
"filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2646
msgid ""
"The plugin ignores comments within<constant> //</constant>... and <constant>/"
"*</constant> ... <constant>*/</constant> delimiters in C, C++, PHP and "
"JavaScript files."
msgstr ""
"Wtyczka ignoruje komentarze wewnątrz<constant> //</constant>... i <constant>/"
"*</constant> ... <constant>*/</constant> ograniczniki w plikach C, C++, PHP "
"i JavaScript."

#. type: Content of: <article><section><section><para><segmentedlist><seglistitem><seg>
#: English/Plugins.xml:2662
msgid ""
"<filename class=\"extension\">*.cpp</filename>, <filename "
"class=\"extension\">*.cxx</filename>, <filename class=\"extension\">*.h</"
"filename>, <filename class=\"extension\">*.hxx</filename>, <filename "
"class=\"extension\">*.c</filename>, <filename class=\"extension\">*.php</"
"filename>, <filename class=\"extension\">*.js</filename>, <filename "
"class=\"extension\">*.cs</filename>, <filename class=\"extension\">*.ts</"
"filename>"
msgstr ""
"<filename class=\"extension\">*.cpp</filename>, <filename "
"class=\"extension\">*.cxx</filename>, <filename class=\"extension\">*.h</"
"filename>, <filename class=\"extension\">*.hxx</filename>, <filename "
"class=\"extension\">*.c</filename>, <filename class=\"extension\">*.php</"
"filename>, <filename class=\"extension\">*.js</filename>, <filename "
"class=\"extension\">*.cs</filename>, <filename class=\"extension\">*.ts</"
"filename>"

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2681
msgid "IgnoreFieldsComma plugin file"
msgstr "Plik wtyczki IgnoreFieldsComma"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2680
msgid ""
"<filename>IgnoreFieldsComma<placeholder type=\"indexterm\" id=\"0\"/></"
"filename>"
msgstr ""
"<filename>IgnoreFieldsComma<placeholder type=\"indexterm\" id=\"0\"/></"
"filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2684
msgid ""
"This plugin is for files with fields and commas as delimiters (CSV files, "
"for example). It ignores the delimiter characters. The first field is number "
"1."
msgstr ""
"Ta wtyczka jest przeznaczona dla plików z polami i przecinkami jako "
"ogranicznikami (na przykład pliki CSV). Ignoruje znaki rozdzielające. "
"Pierwsze pole ma numer 1."

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2688 English/Plugins.xml:2723
msgid ""
"To specify the delimiters, use plugin settings dialog or rename the "
"<filename>dll</filename> using the same parameter fields used for <xref "
"linkend=\"IgnoreColumns\" />."
msgstr ""
"Aby określić ograniczniki, użyj okna ustawień wtyczki lub zmień nazwę pliku "
"<filename>dll</filename> przy użyciu tych samych pól parametrów, które są "
"używane <xref linkend=\"IgnoreColumns\" />."

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2715
msgid "IgnoreFieldsTab plugin file"
msgstr "Plik wtyczki IgnoreFieldsTab"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2714
msgid ""
"<filename>IgnoreFieldsTab<placeholder type=\"indexterm\" id=\"0\"/></"
"filename>"
msgstr ""
"<filename>IgnoreFieldsTab<placeholder type=\"indexterm\" id=\"0\"/></"
"filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2718
msgid ""
"This plugin is for files that use fields and tabs as delimiters "
"(<application>for example, Excel</application> files saved in the <filename "
"class=\"extension\">*.txt</filename> format). It ignores the delimiter "
"characters. The first field is number 1."
msgstr ""
"Ta wtyczka jest przeznaczona dla plików, które używają pól i tabulatorów "
"jako ograniczników (<application>na przykład Excela</application> pliki "
"zapisane w formacie <filename class=\"extension\">*.txt</filename> "
"formacie). Ignoruje znaki rozdzielające. Pierwsze pole ma numer 1."

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2750
msgid "IgnoreLeadingLineNumbers plugin file"
msgstr "Plik wtyczki IgnoreLeadingLineNumbers"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2749
msgid ""
"<filename>IgnoreLeadingLineNumbers<placeholder type=\"indexterm\" id=\"0\"/"
"></filename>"
msgstr ""
"<filename>IgnoreLeadingLineNumbers<placeholder type=\"indexterm\" id=\"0\"/"
"></filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2753
msgid ""
"This plugin ignores the leading line numbers in text files (for example, NC "
"and BASIC files)."
msgstr ""
"Ta wtyczka ignoruje numery wiodących linii w plikach tekstowych (na przykład "
"plikach NC i BASIC)."

#. type: Content of: <article><section><section><para><segmentedlist><segtitle>
#: English/Plugins.xml:2765
msgid "Requirement"
msgstr "Wymaganie"

#. type: Content of: <article><section><section><para><segmentedlist><seglistitem><seg>
#: English/Plugins.xml:2770
msgid "<filename class=\"extension\">*.nc</filename>"
msgstr "<filename class=\"extension\">*.nc</filename>"

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2781
msgid "editor addin plugin file"
msgstr "plik wtyczki dodatku edytora"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2780
msgid ""
"<filename>editor addin<placeholder type=\"indexterm\" id=\"0\"/></filename>"
msgstr ""
"<filename>editor addin<placeholder type=\"indexterm\" id=\"0\"/></filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2784
msgid ""
"Adds some functions to the <menuchoice> <guimenu>Plugins</guimenu> "
"<guisubmenu>Scripts</guisubmenu> </menuchoice> menu:"
msgstr ""
"Dodaje pewne funkcje do <menuchoice> <guimenu>Wtyczki</guimenu> "
"<guisubmenu>Skrypty</guisubmenu> </menuchoice> menu:"

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2792
msgid ""
"<guimenuitem>Make Uppercase</guimenuitem> convert the selection to UPPER "
"CASE."
msgstr ""
"<guimenuitem>Zrób wielkie litery</guimenuitem> przekonwertuj zaznaczenie na "
"WIELKIE LITERY."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2797
msgid ""
"<guimenuitem>Make Lowercase</guimenuitem> convert the selection to lower "
"case."
msgstr ""
"<guimenuitem>Utwórz małe litery</guimenuitem> przekonwertuj zaznaczenie na "
"małe litery."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2802
msgid ""
"<guimenuitem>Remove Duplicate Lines</guimenuitem> remove duplicate lines in "
"the selection."
msgstr ""
"<guimenuitem>Usuń zduplikowane linie</guimenuitem> usuń zduplikowane linie w "
"zaznaczeniu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2807
msgid ""
"<guimenuitem>Count Duplicate Lines</guimenuitem> remove duplicate lines in "
"the selection and insert the number of duplicate lines on the right."
msgstr ""
"<guimenuitem>Policz zduplikowane linie</guimenuitem> usuń zduplikowane linie "
"w zaznaczeniu i wstaw liczbę zduplikowanych linii po prawej stronie."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2812
msgid ""
"<guimenuitem>Sort Lines Ascending</guimenuitem> sort the selection in "
"ascending order."
msgstr ""
"<guimenuitem>Sortuj linie rosnąco</guimenuitem> posortuj zaznaczenie w "
"kolejności rosnącej."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2817
msgid ""
"<guimenuitem>Sort Lines Descending</guimenuitem> sort the selection in "
"descending order."
msgstr ""
"<guimenuitem>Sortuj linie malejąco</guimenuitem> posortuj zaznaczenie w "
"kolejności malejącej."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2822
msgid ""
"<guimenuitem>Reverse Columns</guimenuitem> reverse columns in the selection."
msgstr ""
"<guimenuitem>Odwrócone kolumny</guimenuitem> odwróć kolumny w zaznaczeniu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2827
msgid ""
"<guimenuitem>Reverse Lines</guimenuitem> reverse lines in the selection."
msgstr "<guimenuitem>Linie odwrotne</guimenuitem> odwróć linie w zaznaczeniu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2832
msgid ""
"<guimenuitem>Select Columns...</guimenuitem> select some columns in the "
"selection."
msgstr ""
"<guimenuitem>Wybierz kolumny...</guimenuitem> wybierz niektóre kolumny w "
"zaznaczeniu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2837
msgid ""
"<guimenuitem>Select Lines...</guimenuitem> select some lines in the "
"selection."
msgstr ""
"<guimenuitem>Wybierz linie...</guimenuitem> wybierz kilka linii w "
"zaznaczeniu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2842
msgid ""
"<guimenuitem>Replace...</guimenuitem> replace text in the selection with "
"another text."
msgstr ""
"<guimenuitem>Wymień...</guimenuitem> zastąp tekst w zaznaczeniu innym "
"tekstem."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2847
msgid ""
"<guimenuitem>Apply Filter Command...</guimenuitem> replace the selection "
"with the output of the specified filter command.  Specifying %1 in the "
"argument of the filter command replaces it with the filename of the active "
"pane."
msgstr ""
"<guimenuitem>Zastosuj polecenie filtra...</guimenuitem> zastąp zaznaczenie "
"danymi wyjściowymi określonego polecenia filtrującego.  Określanie %1 w "
"argumencie polecenia filter zastępuje go nazwą pliku aktywnego panelu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2853
msgid ""
"<guimenuitem>Tokenize...</guimenuitem> replaces the token delimiter with a "
"newline in the selection."
msgstr ""
"<guimenuitem>Tokenizuj...</guimenuitem> zastępuje ogranicznik tokenu znakiem "
"nowej linii w zaznaczeniu."

#. type: Content of: <article><section><section><itemizedlist><listitem><simpara>
#: English/Plugins.xml:2858
msgid ""
"<guimenuitem>Trim Spaces</guimenuitem> remove spaces at the beginning and "
"end of lines in the selection."
msgstr ""
"<guimenuitem>Przytnij spacje</guimenuitem> usuń spacje na początku i na "
"końcu linii w zaznaczeniu."

