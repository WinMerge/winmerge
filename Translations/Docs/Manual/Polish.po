#: English/Plugins.xml:2474
msgid "<filename>Tokenize<placeholder type=\"indexterm\" id=\"0\"/></filename>"
msgstr ""
"<filename>Tokenize<placeholder type=\"indexterm\" id=\"0\"/></filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2478
msgid "Tokenizes selection"
msgstr "Tokenizuje wybór"

#. type: Content of: <article><section><section><cmdsynopsis>
