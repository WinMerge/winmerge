#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1561
msgid "<literal>Size &lt; 10KB</literal> - Any side's size is less than 10KB"
msgstr ""
"<literal>Size &lt; 10KB</literal> - Rozmiar dowolnej strony jest mniejszy "
"niż 10 KB"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1562
msgid ""
"<literal>LeftSize &gt;= 10MB</literal> - Left side file is at least 10MB"
msgstr ""
"<literal>LeftSize &gt;= 10MB</literal> - Plik po lewej stronie ma rozmiar co "
"najmniej 10 MB"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1563
msgid "<literal>allof(Size &lt; 1MB)</literal> - All sides are under 1MB"
msgstr ""
"<literal>allof(Size &lt; 1MB)</literal> - Wszystkie strony mają mniej niż 1MB"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1564
msgid ""
"<literal>abs(LeftSize - RightSize) &lt; 1KB</literal> - Size difference is "
"small"
msgstr ""
"<literal>abs(LeftSize - RightSize) &lt; 1KB</literal> - Różnica w wielkości "
"jest niewielka"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1565
msgid ""
"<literal>DateStr = \"2025-07-20\"</literal> - File was last modified on that "
"date"
msgstr ""
"<literal>DateStr = \"2025-07-20\"</literal> - Plik był ostatnio modyfikowany "
"w tym dniu"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1566
msgid "<literal>Date &gt;= today()</literal> - Modified today or later"
msgstr ""
"<literal>Date &gt;= today()</literal> - Zmodyfikowano dzisiaj lub później"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1567
msgid ""
"<literal>Date &gt; d\"2026-05-21 07:16:33\"</literal> - Modified after a "
"specific date and time"
msgstr ""
"<literal>Date &gt; d\"2026-05-21 07:16:33\"</literal> - Zmodyfikowano po "
"określonej dacie i godzinie"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1568
msgid ""
"<literal>isWithin(Date, d\"2026-01-01\", d\"2026-12-31 23:59:59\")</literal> "
"- Modified during the year 2026"
msgstr ""
"<literal>isWithin(Date, d\"2026-01-01\", d\"2026-12-31 23:59:59\")</literal> "
"- Zmodyfikowano w roku 2026"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1569
msgid ""
"<literal>isWithin(Date, today() - 7days, today())</literal> - File modified "
"within the last week"
msgstr ""
"<literal>isWithin(Date, today() - 7days, today())</literal> - Plik "
"zmodyfikowano w ciągu ostatniego tygodnia"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1570
msgid ""
"<literal>inRange(Size, 1KB, 10MB)</literal> - File size is between 1KB "
"(inclusive) and 10MB (exclusive)"
msgstr ""
"<literal>inRange(Size, 1KB, 10MB)</literal> - Rozmiar pliku wynosi od 1 KB "
"(włącznie) do 10 MB (wyłącznie)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1571
msgid ""
"<literal>allof(isWithin(Size, 100KB, 1MB))</literal> - All file sizes are "
"between 100KB and 1MB"
msgstr ""
"<literal>allof(isWithin(Size, 100KB, 1MB))</literal> - Wszystkie rozmiary "
"plików mieszczą się w przedziale od 100 KB do 1 MB"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1572
msgid "<literal>AttrStr contains \"R\"</literal> - File is read-only"
msgstr "<literal>AttrStr contains \"R\"</literal> - Plik jest tylko do odczytu"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1573
msgid "<literal>Name matches \"file[0-9]\\.txt\"</literal> - Regex on filename"
msgstr ""
"<literal>Name matches \"file[0-9]\\.txt\"</literal> - Regex na nazwie pliku"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1574
msgid ""
"<literal>Content contains \"Test\"</literal> - File content includes keyword"
msgstr ""
"<literal>Content contains \"Test\"</literal> - Zawartość pliku zawiera słowo "
"kluczowe"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1575
msgid ""
"<literal>sublines(Content, 0, 1) contains \"XML\"</literal> - First line "
"contains \"XML\""
msgstr ""
"<literal>sublines(Content, 0, 1) contains \"XML\"</literal> - Pierwsza linia "
"zawiera „XML”"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1576
msgid ""
"<literal>strCount(Content, \"TODO\") &gt; 5</literal> - File contains more "
"than 5 TODO comments"
msgstr ""
"<literal>strCount(Content, \"TODO\") &gt; 5</literal> - Plik zawiera więcej "
"niż 5 komentarzy do zrobienia"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1577
msgid ""
"<literal>regexCount(Content, \"\\bFIXME\\b\") &gt; 0</literal> - File "
"contains at least one FIXME marker"
msgstr ""
"<literal>regexCount(Content, \"\\bFIXME\\b\") &gt; 0</literal> - Plik "
"zawiera co najmniej jeden znacznik FIXME"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1578
msgid ""
"<literal>strFind(Name, \"_test\") != none</literal> - Files containing "
"\"_test\" in their name"
msgstr ""
"<literal>strFind(Name, \"_test\") != none</literal> - Pliki zawierające w "
"nazwie „_test”."

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1579
msgid ""
"<literal>strFind(Name, \".\", 1) &gt; 0</literal> - Files with multiple dots "
"in their name (second dot exists)"
msgstr ""
"<literal>strFind(Name, \".\", 1) &gt; 0</literal> - Pliki z wieloma kropkami "
"w nazwie (istnieje druga kropka)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1580
msgid ""
"<literal>regexFind(Name, \"\\d{4}\") &lt; 5</literal> - Files where a 4-"
"digit number appears within the first 5 characters"
msgstr ""
"<literal>regexFind(Name, \"\\d{4}\") &lt; 5</literal> - Pliki, w których w "
"ciągu pierwszych 5 znaków występuje 4-cyfrowa liczba"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1581
msgid ""
"<literal>regexExtract(Name, \"v(\\d+)\\.(\\d+)\\.(\\d+)\", 1) = \"2\"</"
"literal> - Files with major version 2 (e.g., \"v2.16.48\")"
msgstr ""
"<literal>regexExtract(Name, \"v(\\d+)\\.(\\d+)\\.(\\d+)\", 1) = \"2\"</"
"literal> - Pliki z wersją główną 2 (np. „v2.16.48”)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1582
msgid ""
"<literal>regexExtract(Name, \"([^_]+)_([^_]+)\\.txt\", 2) like \"test*\"</"
"literal> - Files where second part of name starts with \"test\""
msgstr ""
"<literal>regexExtract(Name, \"([^_]+)_([^_]+)\\.txt\", 2) like \"test*\"</"
"literal> - Pliki, w których druga część nazwy zaczyna się od „test”"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1583
msgid ""
"<literal>le:regexExtract(Line, \"(\\d+)\", 0, 1)</literal> - Extracts the "
"second number in each line (offset=1)"
msgstr ""
"<literal>le:regexExtract(Line, \"(\\d+)\", 0, 1)</literal> - Wyodrębnia "
"drugą liczbę w każdej linii (offset=1)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1584
msgid ""
"<literal>(Extension = \"log\" and Size > 10MB) or (Date &lt; today() - "
"7days)</literal> - Large log files or files older than a week"
msgstr ""
"<literal>(Extension = \"log\" and Size > 10MB) or (Date &lt; today() - "
"7days)</literal> - Duże pliki dziennika lub pliki starsze niż tydzień"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1585
msgid ""
"<literal>AttrStr not contains \"H\" and Name like \"*.tmp\"</literal> - Non-"
"hidden temporary files"
msgstr ""
"<literal>AttrStr not contains \"H\" and Name like \"*.tmp\"</literal> - "
"Nieukryte pliki tymczasowe"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1586
msgid ""
"<literal>isWithin(Extension, \"a\", \"m\") and inRange(Size, 0, 1MB)</"
"literal> - Files with extensions from 'a' to 'm' and size less than 1MB"
msgstr ""
"<literal>isWithin(Extension, \"a\", \"m\") and inRange(Size, 0, 1MB)</"
"literal> - Pliki z rozszerzeniami od „a” do „m” i wielkości mniejszej niż 1MB"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1587
msgid ""
"<literal>toLower(Name) = \"readme.txt\"</literal> - Case-insensitive "
"filename matching"
msgstr ""
"<literal>toLower(Name) = \"readme.txt\"</literal> - Dopasowywanie nazw "
"plików bez uwzględniania wielkości liter"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1588
msgid ""
"<literal>toHalfWidth(Name) like \"*.txt\"</literal> - Match after converting "
"full-width to half-width"
msgstr ""
"<literal>toHalfWidth(Name) like \"*.txt\"</literal> - Dopasuj po konwersji "
"pełnej szerokości na połowę szerokości"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1589
msgid ""
"<literal>trim(Name) = \"readme.txt\"</literal> - Match filename after "
"removing leading/trailing whitespace"
msgstr ""
"<literal>trim(Name) = \"readme.txt\"</literal> - Dopasuj nazwę pliku po "
"usunięciu początkowych/końcowych białych znaków"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1590
msgid ""
"<literal>trimLeft(Column(\"Value\")) = \"123\"</literal> - Match column "
"value after removing leading whitespace (table mode)"
msgstr ""
"<literal>trimLeft(Column(\"Value\")) = \"123\"</literal> - Dopasuj wartość "
"kolumny po usunięciu wiodących białych znaków (tryb tabeli)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1591
msgid ""
"<literal>trimRight(Line) contains \"end\"</literal> - Check if line (without "
"trailing whitespace) contains \"end\""
msgstr ""
"<literal>trimRight(Line) contains \"end\"</literal> - Sprawdź, czy linia "
"(bez końcowych białych znaków) zawiera „koniec”"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1592
msgid "<literal>EOL = 3</literal> - Files with CRLF (Windows) line endings"
msgstr "<literal>EOL = 3</literal> - Pliki z końcówkami linii CRLF (Windows)."

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1593
msgid "<literal>EOLStr = \"LF\"</literal> - Files with LF (Unix) line endings"
msgstr ""
"<literal>EOLStr = \"LF\"</literal> - Pliki z końcówkami linii LF (Unix)."

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1594
msgid ""
"<literal>allof(EOL = 1)</literal> - Checks whether all compared files use LF "
"line endings"
msgstr ""
"<literal>allof(EOL = 1)</literal> - Sprawdza, czy wszystkie porównywane "
"pliki korzystają z końcówek linii LF"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1595
msgid ""
"<literal>leftprop(\"System.Title\") != none</literal> - Left file has a "
"title property set"
msgstr ""
"<literal>leftprop(\"System.Title\") != none</literal> - Lewy plik ma "
"ustawioną właściwość tytułu"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1596
msgid ""
"<literal>prop(\"System.Author\") = none</literal> - No author property is "
"set on any side"
msgstr ""
"<literal>prop(\"System.Author\") = none</literal> - Żadna właściwość autora "
"nie jest ustawiona po żadnej stronie"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1597
msgid ""
"<literal>if(LeftExists, LeftSize, 0) == 0</literal> - Checks whether the "
"left file is missing or empty"
msgstr ""
"<literal>if(LeftExists, LeftSize, 0) == 0</literal> - Sprawdza, czy brakuje "
"lewego pliku lub czy jest on pusty"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1598
msgid ""
"<literal>Different</literal> - Show only files/folders that are different "
"(Display filter only)"
msgstr ""
"<literal>Different</literal> - Pokaż tylko różne pliki/foldery (tylko filtr "
"wyświetlania)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1599
msgid ""
"<literal>Identical</literal> - Show only files/folders that are identical "
"(Display filter only)"
msgstr ""
"<literal>Identical</literal> - Pokaż tylko identyczne pliki/foldery (tylko "
"filtr wyświetlania)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1600
msgid ""
"<literal>allof(Binary)</literal> - Show only files that are binary on all "
"sides (Display filter only)"
msgstr ""
"<literal>allof(Binary)</literal> - Pokaż tylko pliki binarne ze wszystkich "
"stron (tylko filtr wyświetlania)"

#. type: Content of: <article><section><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1601
msgid ""
"<literal>DifferentLeftMiddle and not DifferentMiddleRight</literal> - In 3-"
"way comparison, show files where only left-middle pair differs (Display "
"filter only)"
msgstr ""
"<literal>DifferentLeftMiddle and not DifferentMiddleRight</literal> - W "
"porównaniu trójstronnym pokaż pliki, w których różni się tylko para lewa-"
"środkowa (tylko filtr wyświetlania)"

#. type: Content of: <article><section><title>
#: English/Filters.xml:1608
msgid ""
"Using file filters<placeholder type=\"indexterm\" id=\"0\"/><placeholder "
"type=\"indexterm\" id=\"1\"/>"
msgstr ""
"Korzystanie z filtrów plików<placeholder type=\"indexterm\" id=\"0\"/"
"><placeholder type=\"indexterm\" id=\"1\"/>"

#. type: Content of: <article><section><para>
#: English/Filters.xml:1618
msgid ""
"<glossterm>File filters</glossterm> are text files with an extension of "
"<filename>flt</filename>. They enable you to apply multiple filtering rules "
"to a folder comparison. Unlike file masks, file filters can either include "
"or exclude matches."
msgstr ""
"<glossterm>Filtry plików</glossterm> to pliki tekstowe z rozszerzeniem "
"<filename>flt</filename>. Umożliwiają zastosowanie wielu reguł filtrowania "
"do porównania folderów. W przeciwieństwie do masek plików, filtry plików "
"mogą uwzględniać lub wykluczać dopasowania."

#. type: Content of: <article><section><para><indexterm><secondary>
#: English/Filters.xml:1626
msgid "template"
msgstr "szablon"

#. type: Content of: <article><section><para>
#: English/Filters.xml:1623
msgid ""
"<placeholder type=\"indexterm\" id=\"0\"/>WinMerge installs a number of "
"predefined file filters. If these file filters do not provide the filtering "
"you need, you can create your own. To make that task easier, WinMerge also "
"provides a template file named <filename>FileFilter.tmpl</filename>. This "
"section describes how to apply file filters to comparisons, and documents "
"the file filter syntax.  <xref linkend=\"Filters_dlg\" /> describes how to "
"add, edit, and manage filters."
msgstr ""
"<placeholder type=\"indexterm\" id=\"0\"/>WinMerge instaluje wiele "
"predefiniowanych filtrów plików. Jeśli te filtry plików nie zapewniają "
"wymaganego filtrowania, możesz utworzyć własne. Aby ułatwić to zadanie, "
"WinMerge udostępnia również plik szablonu o nazwie <filename>FileFilter."
"tmpl</filename>. W tej sekcji opisano sposób stosowania filtrów plików do "
"porównań i dokumentowano składnię filtrów plików.  <xref "
"linkend=\"Filters_dlg\" /> opisuje, jak dodawać, edytować i zarządzać "
"filtrami."

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:1639 English/Filters.xml:1643
msgid "locations"
msgstr "lokalizacje"

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:1636
msgid ""
"File filter locations<placeholder type=\"indexterm\" id=\"0\"/><placeholder "
"type=\"indexterm\" id=\"1\"/>"
msgstr ""
"Lokalizacje filtrów plików<placeholder type=\"indexterm\" id=\"0\"/"
"><placeholder type=\"indexterm\" id=\"1\"/>"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1646
msgid "WinMerge automatically detects file filters in these locations:"
msgstr ""
"WinMerge automatycznie wykrywa filtry plików w następujących lokalizacjach:"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1651
msgid "Filters subfolder in the WinMerge installation folder"
msgstr "Podfolder Filters w folderze instalacyjnym WinMerge"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1654
msgid ""
"This is where the predefined file filters are installed. For example, "
"<filename>C:\\Program Files\\WinMerge\\Filters</filename>. You can create or "
"copy filter files in this location to make them available to all users on "
"your system."
msgstr ""
"W tym miejscu instalowane są predefiniowane filtry plików. Na przykład "
"<filename>C:\\Program Files\\WinMerge\\Filters</filename>. Możesz tworzyć "
"lub kopiować pliki filtrów w tej lokalizacji, aby udostępnić je wszystkim "
"użytkownikom w systemie."

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1659
msgid ""
"Before creating a new file filter, see if the predefined ones already "
"contain what you need. If not, you might find useful rule examples in the "
"existing files."
msgstr ""
"Przed utworzeniem nowego filtra plików sprawdź, czy predefiniowane filtry "
"zawierają już to, czego potrzebujesz. Jeśli nie, przydatne przykłady reguł "
"możesz znaleźć w istniejących plikach."

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1666
msgid "Default private filter folder"
msgstr "Domyślny folder filtrów prywatnych"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1669
msgid ""
"The location of this folder is defined in the System page of WinMerge "
"options. By default, it is specified as a subfolder in your user profile "
"folder (for example, <filename>Documents</filename> in Windows 10). Filters "
"that are created or copied here are normally visible only to you. If you "
"create new file filters, you can copy them here to keep them private."
msgstr ""
"Lokalizacja tego folderu jest zdefiniowana na stronie System w opcjach "
"WinMerge. Domyślnie jest on określony jako podfolder w folderze profilu "
"użytkownika (na przykład <filename>Documents</filename> w Windowsie 10). "
"Filtry utworzone lub skopiowane w tym miejscu są zwykle widoczne tylko dla "
"Ciebie. Jeśli utworzysz nowe filtry plików, możesz je tutaj skopiować, aby "
"zachować prywatność."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1679
msgid ""
"Before you can apply file filters that exist in any other folder, you must "
"first install them."
msgstr ""
"Zanim będzie można zastosować filtry plików istniejące w jakimkolwiek innym "
"folderze, należy je najpierw zainstalować."

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:1687
msgid "applying"
msgstr "zastosowanie"

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:1684
msgid "Applying file filters<placeholder type=\"indexterm\" id=\"0\"/>"
msgstr "Stosowanie filtrów plików<placeholder type=\"indexterm\" id=\"0\"/>"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1690
msgid "You can apply a file filter using any of these methods:"
msgstr "Filtr plików można zastosować dowolną z następujących metod:"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1694
msgid ""
"When you launch a folder compare from the Select Files or Folders dialog:"
msgstr ""
"Po uruchomieniu porównywania folderów w oknie dialogowym Wybierz pliki lub "
"foldery:"

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1699
msgid ""
"After choosing the <guilabel>1st</guilabel> and <guilabel>2nd</guilabel> "
"folders, click <guibutton>Select</guibutton> next to the <guilabel>Filter</"
"guilabel> field."
msgstr ""
"Po wybraniu <guilabel>1</guilabel> i <guilabel>2</guilabel> foldery, kliknij "
"<guibutton>Wybierz</guibutton> obok <guilabel>Filtruj</guilabel> pole."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1706
msgid ""
"In the Filters dialog, use the File Filters tab to choose a file filter and "
"load it in the <guilabel>Filter</guilabel> field."
msgstr ""
"W oknie dialogowym Filtry użyj karty Filtry plików, aby wybrać filtr plików "
"i załadować go do pliku <guilabel>Filtruj</guilabel> pole."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><note><para>
#: English/Filters.xml:1711
msgid ""
"If a file filter is currently enabled, the selected file filter is already "
"loaded in the <guilabel>Filter</guilabel> field."
msgstr ""
"Jeśli filtr plików jest aktualnie włączony, wybrany filtr plików jest już "
"załadowany w pliku <guilabel>Filtruj</guilabel> pole."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1719
msgid ""
"Proceed with the compare operation. The file in the <guilabel>Filter</"
"guilabel> field is applied when you start the operation."
msgstr ""
"Kontynuuj operację porównywania. Plik w <guilabel>Filtruj</guilabel> pole "
"jest stosowane w momencie rozpoczęcia operacji."

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1727
msgid ""
"To change file filtering after you have already launched a folder compare "
"operation (for example, applying a different filter or disabling filtering):"
msgstr ""
"Aby zmienić filtrowanie plików po uruchomieniu operacji porównywania "
"folderów (na przykład zastosowaniu innego filtra lub wyłączeniu filtrowania):"

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1733 English/Filters.xml:2001
msgid ""
"Click <menuchoice> <guimenu>Tools</guimenu> <guimenuitem>Filters</"
"guimenuitem> </menuchoice>."
msgstr ""
"Kliknij <menuchoice> <guimenu>Narzędzia</guimenu> <guimenuitem>Filtry</"
"guimenuitem> </menuchoice>."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1741
msgid ""
"In the Filters dialog, configure your new file filter setting, and click "
"<guibutton>OK</guibutton>."
msgstr ""
"W oknie dialogowym Filtry skonfiguruj nowe ustawienie filtra plików i "
"kliknij <guibutton>OK</guibutton>."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1746
msgid ""
"The new filtering is not automatically applied when you close the Filters "
"dialog: press <keycap>F5</keycap> to see the new results in the Folder "
"Compare window."
msgstr ""
"Nowe filtrowanie nie zostanie automatycznie zastosowane po zamknięciu okna "
"dialogowego Filtry: naciśnij <keycap>F5</keycap> , aby zobaczyć nowe wyniki "
"w oknie Porównanie folderów."

#. type: Content of: <article><section><section><itemizedlist><listitem><para><indexterm><secondary>
#: English/Filters.xml:1757
msgid "applying file filters"
msgstr "stosowanie filtrów plików"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1754
msgid ""
"<placeholder type=\"indexterm\" id=\"0\"/>When you launch a folder compare "
"from the WinMerge command line, use the <option>-f</option> flag to specify "
"a file filter."
msgstr ""
"<placeholder type=\"indexterm\" id=\"0\"/>Po uruchomieniu porównywania "
"folderów z wiersza poleceń WinMerge użyj metody <option>-f</option> flaga "
"określająca filtr plików."

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:1769
msgid "file filter"
msgstr "filtr plików"

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:1773
msgid "syntax"
msgstr "składnia"

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:1766
msgid ""
"File filter syntax<placeholder type=\"indexterm\" id=\"0\"/><placeholder "
"type=\"indexterm\" id=\"1\"/>"
msgstr ""
"Składnia filtra plików<placeholder type=\"indexterm\" id=\"0\"/><placeholder "
"type=\"indexterm\" id=\"1\"/>"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1776
msgid ""
"This section describes the syntax of WinMerge file filters and provides "
"guidelines for writing them."
msgstr ""
"W tej sekcji opisano składnię filtrów plików WinMerge i podano wskazówki "
"dotyczące ich pisania."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1779
msgid ""
"The comment delimiter is <code>##</code>. After a comment delimiter, all "
"characters in a line are ignored. WinMerge ignores most whitespace "
"characters in rules. However, a comment must always be preceded by one or "
"more whitespace (space or tab) characters. To use <code>##</code> as "
"characters in a rule, omit the whitespace prefix."
msgstr ""
"Ogranicznik komentarza to <code>##</code>. Po ograniczniku komentarza "
"wszystkie znaki w wierszu są ignorowane. WinMerge ignoruje większość białych "
"znaków w regułach. Jednakże komentarz musi być zawsze poprzedzony co "
"najmniej jednym znakiem odstępu (spacją lub tabulatorem). Do użycia "
"<code>##</code> jako znaki w regule, pomiń przedrostek białych znaków."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1785
msgid "The first two required lines of a file filter are:"
msgstr "Pierwsze dwie wymagane linie filtra plików to:"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1789
msgid "name"
msgstr "imię"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1792
msgid "The filter name that is listed in the Files dialog"
msgstr "Nazwa filtra wyświetlana w oknie dialogowym Pliki"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1797
msgid "def"
msgstr "def"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1800
msgid "The type of filtering to be applied. Specify one of these values:"
msgstr ""
"Typ filtrowania, który ma zostać zastosowany. Określ jedną z tych wartości:"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><variablelist><varlistentry><term>
#: English/Filters.xml:1805
msgid "include"
msgstr "zawierać"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1808
msgid "Includes everything except items matching the specified rule."
msgstr "Zawiera wszystko oprócz elementów pasujących do określonej reguły."

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><variablelist><varlistentry><term>
#: English/Filters.xml:1814
msgid "exclude"
msgstr "wykluczyć"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1817
msgid "Excludes everything except items matching the specified rule."
msgstr ""
"Wyklucza wszystko z wyjątkiem elementów pasujących do określonej reguły."

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1820
msgid ""
"When you choose the exclude method, you must also add a <guilabel>d</"
"guilabel> (directory) rule that specifies the subfolders. It's usually a "
"good idea to specify all subfolders, like this:"
msgstr ""
"Kiedy wybierzesz metodę wykluczania, musisz także dodać <guilabel>d</"
"guilabel> (katalog) reguła określająca podfoldery. Zwykle dobrym pomysłem "
"jest określenie wszystkich podfolderów, w ten sposób:"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><variablelist><varlistentry><listitem><screen>
#: English/Filters.xml:1825
#, no-wrap
msgid "d: \\\\*$ ## Subfolders"
msgstr "d: \\\\*$ ## Podfoldery"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><tip><para>
#: English/Filters.xml:1831
msgid ""
"Don't confuse these terms. Remember, in file filters, an <guilabel>include</"
"guilabel> rule does not specify what to include, it specifies what "
"<emphasis>not</emphasis> to include.  Similarly, <guilabel>exclude</"
"guilabel> does not specify what to exclude, it specifies what not to exclude."
msgstr ""
"Nie myl tych terminów. Pamiętaj, że w filtrach plików an <guilabel>zawierać</"
"guilabel> reguła nie określa, co należy uwzględnić, określa co "
"<emphasis>nie</emphasis> uwzględnić.  Podobnie, <guilabel>wykluczyć</"
"guilabel> nie określa, co należy wykluczyć, określa, czego nie należy "
"wykluczać."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1841
msgid ""
"Next, your file should contain one or more filter rules. You can add as many "
"rules as you like. There must be one rule per line, and each rule must be "
"entirely on one line (no line breaks are allowed in a rule).  A rule begins "
"with a type designator, followed by either a regular expression or a filter "
"expression.  The supported type designators are:"
msgstr ""
"Następnie plik powinien zawierać jedną lub więcej reguł filtrowania. Możesz "
"dodać dowolną liczbę reguł. W każdym wierszu musi znajdować się jedna "
"reguła, a każda reguła musi znajdować się w całości w jednym wierszu (w "
"regule nie są dozwolone żadne podziały wierszy).  Reguła zaczyna się od "
"oznaczenia typu, po którym następuje wyrażenie regularne lub wyrażenie "
"filtrujące.  Obsługiwane oznaczenia typów to:"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1849
msgid "Match file names using regular expressions"
msgstr "Dopasuj nazwy plików za pomocą wyrażeń regularnych"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1850
msgid "Exclude files matching regex (Available since 2.16.19)"
msgstr "Wyklucz pliki pasujące do wyrażenia regularnego (dostępne od 2.16.19)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1851
msgid "Match folder names using regex"
msgstr "Dopasuj nazwy folderów za pomocą wyrażenia regularnego"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1852
msgid "Exclude folders matching regex (Available since 2.16.19)"
msgstr ""
"Wyklucz foldery pasujące do wyrażenia regularnego (dostępne od 2.16.19)"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1857
msgid "e: <replaceable>expr</replaceable>"
msgstr "mi: <replaceable>expr</replaceable>"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1857
msgid ""
"Filter expression applied to both files and folders (e.g. e:Name like "
"\"Common*.*\") (Available since 2.16.56)"
msgstr ""
"Wyrażenie filtru stosowane zarówno do plików, jak i folderów (np. e:Nazwa "
"typu „Common*.*”) (dostępne od 2.16.56)"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1858
msgid "e!: <replaceable>expr</replaceable>"
msgstr "e!: <replaceable>expr</replaceable>"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1858
msgid ""
"Filter expression to exclude both files and folders (Available since 2.16.56)"
msgstr ""
"Wyrażenie filtru, aby wykluczyć zarówno pliki, jak i foldery (dostępne od "
"2.16.56)"

#. type: Content of: <article><section><section><para><indexterm><secondary>
#: English/Filters.xml:1865
msgid "special characters in filters"
msgstr "znaki specjalne w filtrach"

#. type: Content of: <article><section><section><para><indexterm><secondary>
#: English/Filters.xml:1869
msgid "in file filters"
msgstr "w filtrach plików"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1861
msgid ""
"Among the many regexp special characters, the following are particularly "
"important in file filter rules:<placeholder type=\"indexterm\" id=\"0\"/"
"><placeholder type=\"indexterm\" id=\"1\"/>"
msgstr ""
"Spośród wielu znaków specjalnych wyrażeń regularnych następujące są "
"szczególnie ważne w regułach filtrowania plików:<placeholder "
"type=\"indexterm\" id=\"0\"/><placeholder type=\"indexterm\" id=\"1\"/>"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1874
msgid "^ (beginning of line)"
msgstr "^ (początek linii)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1877
msgid "Frequently required for rules to work correctly."
msgstr "Często wymagane do prawidłowego działania reguł."

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1882
msgid "$ (end of line)"
msgstr "$ (koniec linii)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1885
msgid "Frequently required for rules to work correctly. For example:"
msgstr "Często wymagane do prawidłowego działania reguł. Na przykład:"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><screen>
#: English/Filters.xml:1888
#, no-wrap
msgid ""
"\\.c$ ## matches only file names with the extension, <filename>c</filename>.\n"
"\\.c  ## matches any extension beginning with <filename>c</filename>, like <filename>cpp</filename> and <filename>com</filename>."
msgstr ""
"\\.c$ ## dopasowuje tylko nazwy plików z rozszerzeniem, <filename>c</filename>.\n"
"\\.c ## pasuje do dowolnego rozszerzenia rozpoczynającego się od <filename>c</filename>, jak <filename>cpp</filename> i <filename>com</filename>."

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:1894
msgid "\\ (escape)"
msgstr "\\ (ucieczka)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:1897
msgid ""
"Forces special characters to match normal characters. For example, to match "
"a folder name, precede the folder backslash delimiter with a backslash "
"(<code>\\\\</code>). To match the dot in a file name, specify a backslash "
"followed by a dot (<code>\\.</code>)."
msgstr ""
"Wymusza dopasowanie znaków specjalnych do normalnych znaków. Na przykład, "
"aby dopasować nazwę folderu, poprzedź ogranicznik ukośnika odwrotnego "
"folderu ukośnikiem odwrotnym (<code>\\\\</code>). Aby dopasować kropkę w "
"nazwie pliku, określ ukośnik odwrotny, po którym następuje kropka (<code>\\."
"</code>)."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1906
msgid ""
"No special characters or wildcards are used to match file names. To match "
"all filenames of a certain type, simply omit the filename."
msgstr ""
"Do dopasowywania nazw plików nie są używane żadne znaki specjalne ani "
"symbole wieloznaczne. Aby dopasować wszystkie nazwy plików określonego typu, "
"po prostu pomiń nazwę pliku."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1909
msgid ""
"Rules are case-insensitive. For example, <code>f: \\.bat$</code> matches "
"<filename>winmerge.bat</filename> and <filename>compare.BAT</filename>."
msgstr ""
"W regułach nie jest rozróżniana wielkość liter. Na przykład <code>f: \\."
"bat$</code> mecze <filename>winmerge.bat</filename> i <filename>compare.BAT</"
"filename>."

#. type: Content of: <article><section><section><example><title>
#: English/Filters.xml:1914
msgid "File filter rule examples"
msgstr "Przykłady reguł filtrowania plików"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:1916
msgid "Some simple file filter rules:"
msgstr "Kilka prostych reguł filtrowania plików:"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:1918
#, no-wrap
msgid ""
"f: \\.cpp$ ## Match <filename>*.cpp</filename> files\n"
"f: \\.h$ ## Match <filename>*.h</filename> files\n"
"f: ^My ## Match <filename>My*.*</filename> files\n"
"f: Dlg\\. ## Match <filename>*Dlg.*</filename> files\n"
"d: \\\\test$ ## Match <filename>test</filename> folders\n"
"d: ^\\\\Build$ ## Match <filename>Build</filename> folders\n"
"d: Temp$ ## Match <filename>*Temp</filename> folders (for example, <filename>FirstTemp</filename>)\n"
"d: Src ## Match <filename>*Src*</filename> folders"
msgstr ""
"f: \\.cpp$ ## Dopasowanie <filename>*.cpp</filename> pliki\n"
"f: \\.h$ ## Dopasowanie <filename>*.h</filename> pliki\n"
"f: ^Mój ## mecz <filename>My*.*</filename> pliki\n"
"f: Dlg\\. ## Dopasuj <filename>*Dlg.*</filename> pliki\n"
"d: \\\\test$ ## Dopasowanie <filename>test</filename> foldery\n"
"d: ^\\\\Buduj$ ## Dopasuj <filename>Build</filename> foldery\n"
"d: Temp$ ## Dopasuj <filename>*Temp</filename> foldery (np. <filename>FirstTemp</filename>)\n"
"d: Src ## Dopasowanie <filename>*Src*</filename> foldery"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:1927
msgid "Some rules with more complex regular expressions:"
msgstr "Niektóre reguły z bardziej złożonymi wyrażeniami regularnymi:"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:1929
#, no-wrap
msgid ""
"f: ^\\.#.*$ ## <filename>.#filename.version</filename> files\n"
"f: Dlg\\.c(pp)?$ ## <filename>*Dlg.c</filename> and <filename>*Dlg.cpp</filename> files\n"
"f: ^I.*\\.h$ ## <filename>I*.h</filename> files\n"
"f: Srv[1-9]\\.def$ ## <filename>*Srv1.def</filename> to <filename>*Srv9.def</filename> files\n"
"f: ^[h,k,m] ## <filename>h*.*</filename>, <filename>k*.*</filename>, and <filename>m*.*</filename> files"
msgstr ""
"f: ^\\.#.*$ ## <filename>.#filename.version</filename> pliki\n"
"f: Dlg\\.c(pp)?$ ## <filename>*Dlg.c</filename> i <filename>*Dlg.cpp</filename> pliki\n"
"f: ^I.*\\.h$ ## <filename>I*.h</filename> pliki\n"
"f: Srv[1-9]\\.def$ ## <filename>*Srv1.def</filename> do <filename>*Srv9.def</filename> pliki\n"
"f: ^[h,k,m] ## <filename>h*.*</filename>, <filename>k*.*</filename>, i <filename>m*.*</filename> pliki"

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:1942 English/Filters.xml:2049
msgid "line"
msgstr "linia"

#. type: Content of: <article><section><title><indexterm><secondary>
#: English/Filters.xml:1946 English/Filters.xml:2691
msgid "in file comparisons"
msgstr "w porównaniach plików"

#. type: Content of: <article><section><title>
#: English/Filters.xml:1939
msgid ""
"Using line filters<placeholder type=\"indexterm\" id=\"0\"/><placeholder "
"type=\"indexterm\" id=\"1\"/>"
msgstr ""
"Korzystanie z filtrów liniowych<placeholder type=\"indexterm\" id=\"0\"/"
"><placeholder type=\"indexterm\" id=\"1\"/>"

#. type: Content of: <article><section><para>
#: English/Filters.xml:1949
msgid ""
"In a file comparison, you can use line filters to ignore single lines.  For "
"example, you might use line filters to ignore comments or certain type of "
"generated code, like version control system timestamps. Each line filter is "
"a rule, and you can apply any number of line filters to a file comparison."
msgstr ""
"Podczas porównywania plików możesz użyć filtrów linii, aby zignorować "
"pojedyncze linie.  Na przykład możesz użyć filtrów liniowych, aby zignorować "
"komentarze lub określony typ wygenerowanego kodu, na przykład znaczniki "
"czasu systemu kontroli wersji. Każdy filtr liniowy jest regułą i do "
"porównania plików można zastosować dowolną liczbę filtrów liniowych."

#. type: Content of: <article><section><para>
#: English/Filters.xml:1955
msgid ""
"To learn how to add, edit, and manage filters, see <xref "
"linkend=\"Filters_dlg\" />."
msgstr ""
"Aby dowiedzieć się, jak dodawać, edytować i zarządzać filtrami, zobacz <xref "
"linkend=\"Filters_dlg\" />."

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:1959
msgid "Applying line filters"
msgstr "Stosowanie filtrów liniowych"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:1961
msgid "You can apply line filters using any of these methods:"
msgstr "Filtry liniowe można zastosować dowolną z następujących metod:"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1965
msgid "When you launch a file compare from the Select Files or Folders dialog"
msgstr ""
"Po uruchomieniu porównywania plików w oknie dialogowym Wybierz pliki lub "
"foldery"

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1970
msgid ""
"After choosing the <guilabel>1st</guilabel> and <guilabel>2nd</guilabel> "
"files, click <guibutton>Select</guibutton> next to the <guilabel>Filter</"
"guilabel> field."
msgstr ""
"Po wybraniu <guilabel>1</guilabel> i <guilabel>2</guilabel> pliki, kliknij "
"<guibutton>Wybierz</guibutton> obok <guilabel>Filtruj</guilabel> pole."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1977
msgid ""
"In the Filters dialog, use the Line Filters tab to enable the line filters "
"you want to use (if any), or to see what line filters are currently enabled."
msgstr ""
"W oknie dialogowym Filtry użyj karty Filtry liniowe, aby włączyć filtry "
"liniowe, których chcesz użyć (jeśli istnieją) lub sprawdzić, jakie filtry "
"liniowe są aktualnie włączone."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><note><para>
#: English/Filters.xml:1982
msgid ""
"The <guilabel>Filter</guilabel> field does not indicate what line filters "
"are enabled."
msgstr ""
"The <guilabel>Filtruj</guilabel> pole nie wskazuje, jakie filtry liniowe są "
"włączone."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:1989
msgid ""
"Proceed with the file compare operation. The enabled line filters are "
"applied when you start the operation."
msgstr ""
"Kontynuuj operację porównywania plików. Włączone filtry liniowe zostaną "
"zastosowane po rozpoczęciu operacji."

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:1996
msgid ""
"After you have already launched a file compare operation (for example, to "
"apply different filters or disabling filtering)"
msgstr ""
"Po uruchomieniu operacji porównywania plików (na przykład w celu "
"zastosowania różnych filtrów lub wyłączenia filtrowania)"

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:2009
msgid "Open the File Filters tab."
msgstr "Otwórz kartę Filtry plików."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:2013
msgid ""
"Check the individual line filters you want to apply, and uncheck filters "
"that you don't want to apply."
msgstr ""
"Zaznacz poszczególne filtry liniowe, które chcesz zastosować, i odznacz "
"filtry, których nie chcesz stosować."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:2016
msgid ""
"You can also add, edit, and remove filters from the list by using the "
"<guibutton>New</guibutton>, <guibutton>Edit</guibutton>, and "
"<guibutton>Remove</guibutton> buttons."
msgstr ""
"Możesz także dodawać, edytować i usuwać filtry z listy, korzystając z opcji "
"<guibutton>Nowy</guibutton>, <guibutton>Edytuj</guibutton>, i "
"<guibutton>Usuń</guibutton> przyciski."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:2022
msgid ""
"To turn on line filtering, check the <guilabel>Enable Line Filters</"
"guilabel>. To turn line filtering off, uncheck the option."
msgstr ""
"Aby włączyć filtrowanie linii, zaznacz opcję <guilabel>Włącz filtry liniowe</"
"guilabel>. Aby wyłączyć filtrowanie linii, odznacz tę opcję."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:2028
msgid "Click <guibutton>OK</guibutton> to dismiss the File Filters dialog."
msgstr ""
"Kliknij <guibutton>OK</guibutton> , aby zamknąć okno dialogowe Filtry plików."

#. type: Content of: <article><section><section><itemizedlist><listitem><orderedlist><listitem><para>
#: English/Filters.xml:2033
msgid ""
"Click <keycap>F5</keycap> to apply your changes and refresh the File Compare "
"window."
msgstr ""
"Kliknij <keycap>F5</keycap> , aby zastosować zmiany i odświeżyć okno "
"Porównywanie plików."

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:2045
msgid "line filter"
msgstr "filtr liniowy"

#. type: Content of: <article><section><section><title><indexterm><secondary>
#: English/Filters.xml:2053
msgid "in line filters"
msgstr "w filtrach liniowych"

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:2042
msgid ""
"Line filter syntax<placeholder type=\"indexterm\" id=\"0\"/><placeholder "
"type=\"indexterm\" id=\"1\"/><placeholder type=\"indexterm\" id=\"2\"/>"
msgstr ""
"Składnia filtru liniowego<placeholder type=\"indexterm\" id=\"0\"/"
"><placeholder type=\"indexterm\" id=\"1\"/><placeholder type=\"indexterm\" "
"id=\"2\"/>"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:2056
msgid ""
"A line filter is a rule that is evaluated against each single-line "
"difference in your compared files, if line filter rules are enabled. When a "
"rule matches a single-line difference, the difference is ignored."
msgstr ""
"Filtr liniowy to reguła, która jest oceniana na podstawie każdej pojedynczej "
"różnicy w porównywanych plikach, jeśli reguły filtru liniowego są włączone. "
"Gdy reguła pasuje do różnicy jednowierszowej, różnica ta jest ignorowana."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:2060
msgid ""
"Ignored differences are marked in the File Compare window with the "
"<guilabel>Ignored Difference</guilabel> color (as defined in the Colors page "
"of WinMerge Options). This enables you to distinguish ignored differences "
"from other types. However, you cannot select or merge ignored difference."
msgstr ""
"Zignorowane różnice są zaznaczane w oknie Porównania plików za pomocą "
"<guilabel>Ignorowana różnica</guilabel> kolor (zgodnie z definicją na "
"stronie Kolory w Opcjach WinMerge). Umożliwia to odróżnienie ignorowanych "
"różnic od innych typów. Nie można jednak wybrać ani scalić zignorowanych "
"różnic."

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:2066
msgid "Line filter matching can be described in terms of two ideas:"
msgstr "Dopasowanie filtra liniowego można opisać dwoma pomysłami:"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:2070
msgid ""
"When a rule matches any part of the line, the entire difference is ignored. "
"Therefore, you cannot filter just part of a line. For example, suppose two "
"files have the following single-line difference:"
msgstr ""
"Gdy reguła pasuje do dowolnej części linii, cała różnica jest ignorowana. "
"Dlatego nie można filtrować tylko części linii. Załóżmy na przykład, że dwa "
"pliki mają następującą różnicę w jednej linii:"

#. type: Content of: <article><section><section><orderedlist><listitem><formalpara><title>
#: English/Filters.xml:2076 English/Filters.xml:2098 English/Intro_diffs.xml:60
msgid "File1:"
msgstr "Plik1:"

#. type: Content of: <article><section><section><itemizedlist><listitem><formalpara><para><screen>
#: English/Filters.xml:2078
#, no-wrap
msgid "# Jean Sibelius"
msgstr "#Jean Sibelius"

#. type: Content of: <article><section><section><orderedlist><listitem><formalpara><title>
#: English/Filters.xml:2082 English/Filters.xml:2105 English/Intro_diffs.xml:69
msgid "File2:"
msgstr "Plik2:"

#. type: Content of: <article><section><section><itemizedlist><listitem><formalpara><para><screen>
#: English/Filters.xml:2084
#, no-wrap
msgid "# Janne Sibelius"
msgstr "# Janne Sibelius"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:2087
msgid ""
"With no filtering, the line is detected as a difference. But if we apply a "
"line filter rule with the expression, <code>^#</code>, the lines are "
"reported as identical, because the expression specifies only the first "
"character, which matches in both files."
msgstr ""
"Bez filtrowania linia jest wykrywana jako różnica. Ale jeśli zastosujemy "
"regułę filtru liniowego z wyrażeniem, <code>^#</code>, linie są raportowane "
"jako identyczne, ponieważ wyrażenie określa tylko pierwszy znak, który "
"pasuje w obu plikach."

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:2094
msgid ""
"A rule is applied to a multi-line difference only if all the lines match. "
"For example, consider this two-line difference:"
msgstr ""
"Reguła jest stosowana do różnicy wieloliniowej tylko wtedy, gdy wszystkie "
"linie są zgodne. Rozważmy na przykład tę dwuliniową różnicę:"

#. type: Content of: <article><section><section><itemizedlist><listitem><formalpara><para><screen>
#: English/Filters.xml:2100
#, no-wrap
msgid ""
"# Jean Sibelius\n"
"# Pekka Himanen"
msgstr ""
"#Jean Sibelius\n"
"# Pekka Himanen"

#. type: Content of: <article><section><section><itemizedlist><listitem><formalpara><para><screen>
#: English/Filters.xml:2107
#, no-wrap
msgid ""
"# Janne Sibelius\n"
"Pekka Himanen"
msgstr ""
"# Janne Sibelius\n"
"Pekka Himanena"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:2111
msgid ""
"The same <code>^#</code> rule matches the first line, but not the second "
"line. Therefore, the difference is not ignored."
msgstr ""
"To samo <code>^#</code> reguła pasuje do pierwszej linii, ale nie do drugiej "
"linii. Dlatego różnica nie jest ignorowana."

#. type: Content of: <article><section><section><tip><para>
#: English/Filters.xml:2117
msgid ""
"It's usually good practice to use the beginning of line ( <code>^</code> ) "
"and end of line ( <code>$</code> ) markers to control your patterns "
"precisely, because the rule is applied if any part of a line matches the "
"expression."
msgstr ""
"Zwykle dobrą praktyką jest używanie początku linii ( <code>^</code> ) i "
"koniec linii ( <code>$</code> ) znaczniki umożliwiające precyzyjną kontrolę "
"wzorców, ponieważ reguła jest stosowana, jeśli jakakolwiek część linii "
"pasuje do wyrażenia."

#. type: Content of: <article><section><section><example><title>
#: English/Filters.xml:2124
msgid "Sample line filters"
msgstr "Filtry linii próbnej"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2126
#, no-wrap
msgid "^MYTAG$"
msgstr "^MYTAG$"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2128
msgid "Filters lines that exactly match <literal>MYTAG</literal>"
msgstr "Filtruje dokładnie pasujące linie <literal>MYTAG</literal>"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2130
#, no-wrap
msgid "^::"
msgstr "^::"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2132
msgid "Filters lines beginning with <literal>::</literal>"
msgstr "Filtruje linie zaczynające się od <literal>::</literal>"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2134
#, no-wrap
msgid "^/\\*.*\\*/$"
msgstr "^/\\*.*\\*/$"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2136
msgid ""
"Filters lines beginning with <literal><constant>/*</constant></literal> and "
"ending with <literal>*/</literal>"
msgstr ""
"Filtruje linie zaczynające się od <literal><constant>/*</constant></literal> "
"i kończąc na <literal>*/</literal>"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2140
#, no-wrap
msgid "^[1-5]00"
msgstr "^[1-5]00"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2142
msgid "Filters lines beginning with numbers 100, 200, 300, 400, and 500"
msgstr "Filtruje linie zaczynające się od liczb 100, 200, 300, 400 i 500"

#. type: Content of: <article><section><section><example><title>
#: English/Filters.xml:2147
msgid "Line filter rule matching CVS Id lines"
msgstr "Reguła filtrowania linii pasująca do linii identyfikatora CVS"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2149
msgid "CVS Id lines look like this:"
msgstr "Linie CVS Id wyglądają następująco:"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2151
#, no-wrap
msgid "// $Id: Filters.xml 7591 2013-01-20 15:47:42Z christianlist $"
msgstr "// $Id: Filters.xml 7591 2013-01-20 15:47:42Z christianlist $"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2153 English/Filters.xml:2165
msgid "... and can be filtered with this rule:"
msgstr "... i można je filtrować za pomocą tej reguły:"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2155
#, no-wrap
msgid "^// \\WId: .*\\$"
msgstr "^// \\WId: .*\\$"

#. type: Content of: <article><section><section><example><title>
#: English/Filters.xml:2159
msgid "Filter line number comments in po files"
msgstr "Filtruj komentarze dotyczące numerów linii w plikach po"

#. type: Content of: <article><section><section><example><para>
#: English/Filters.xml:2161
msgid "po line number comments look like this:"
msgstr "komentarze do numerów linii po wyglądają następująco:"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2163
#, no-wrap
msgid "#: src/filename.c:766"
msgstr "#: src/nazwa pliku.c:766"

#. type: Content of: <article><section><section><example><screen>
#: English/Filters.xml:2167
#, no-wrap
msgid "^#"
msgstr "^#"

#. type: Content of: <article><section><title><indexterm><primary>
#: English/Filters.xml:2174
msgid "display line filter"
msgstr "filtr liniowy wyświetlacza"

#. type: Content of: <article><section><title>
#: English/Filters.xml:2173
msgid "Using the display line filter<placeholder type=\"indexterm\" id=\"0\"/>"
msgstr ""
"Korzystanie z filtra liniowego wyświetlacza<placeholder type=\"indexterm\" "
"id=\"0\"/>"

#. type: Content of: <article><section><para>
#: English/Filters.xml:2177
msgid ""
"The display line filter controls which lines are visible in the File Compare "
"window. Lines that do not match the filter are hidden, but the comparison "
"result itself is not affected."
msgstr ""
"Filtr linii wyświetlania kontroluje, które linie są widoczne w oknie "
"Porównywanie plików. Linie niepasujące do filtra są ukrywane, ale nie ma to "
"wpływu na sam wynik porównania."

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:2182
msgid "Opening the display filter bar"
msgstr "Otwieranie paska filtra wyświetlania"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:2184
msgid "Use any of the following methods to open the display filter bar:"
msgstr ""
"Użyj dowolnej z poniższych metod, aby otworzyć pasek filtra wyświetlania:"

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:2189
msgid ""
"Click <menuchoice> <guimenu>View</guimenu> <guimenuitem>Display Filter Bar</"
"guimenuitem> </menuchoice>, or press <keycombo><keycap>Ctrl</"
"keycap><keycap>Shift</keycap> <keycap>L</keycap></keycombo>."
msgstr ""
"Kliknij <menuchoice> <guimenu>Zobacz</guimenu> <guimenuitem>Wyświetl pasek "
"filtra</guimenuitem> </menuchoice>lub naciśnij <keycombo><keycap>Ctrl</"
"keycap><keycap>Przesunięcie</keycap> <keycap>L</keycap></keycombo>."

#. type: Content of: <article><section><section><itemizedlist><listitem><para>
#: English/Filters.xml:2197
msgid ""
"Right-click selected text in the File Compare window and choose <menuchoice> "
"<guimenu>Add to Filters</guimenu> <guimenuitem>Add to Display Filters</"
"guimenuitem> </menuchoice>. WinMerge automatically builds a <literal>Line "
"contains \"...\"</literal> expression from the selected text and opens the "
"filter bar."
msgstr ""
"Kliknij prawym przyciskiem myszy zaznaczony tekst w oknie Porównaj pliki i "
"wybierz <menuchoice> <guimenu>Dodaj do filtrów</guimenu> <guimenuitem>Dodaj "
"do filtrów wyświetlania</guimenuitem> </menuchoice>. WinMerge automatycznie "
"tworzy plik <literal>Line contains \"...\"</literal> wyrażenie z "
"zaznaczonego tekstu i otwiera pasek filtrów."

#. type: Content of: <article><section><para>
#: English/Filters.xml:2207 English/Filters.xml:2649
msgid ""
"To remove the filter, clear the input field and press <keycap>Enter</"
"keycap>. To hide the filter bar while keeping the filter active, click the "
"close button."
msgstr ""
"Aby usunąć filtr, wyczyść pole wprowadzania i naciśnij <keycap>Wejdź</"
"keycap>. Aby ukryć pasek filtra, pozostawiając filtr aktywny, kliknij "
"przycisk zamykania."

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:2213
msgid "Entering a filter"
msgstr "Wejście do filtra"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:2215
msgid ""
"The display filter bar accepts input in two forms, determined by whether the "
"input starts with the <literal>le:</literal> prefix:"
msgstr ""
"Pasek filtra wyświetlania akceptuje dane wejściowe w dwóch postaciach, "
"zależnych od tego, czy dane wejściowe zaczynają się od <literal>le:</"
"literal> przedrostek:"

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2221
msgid "Plain string (no prefix)"
msgstr "Zwykły ciąg znaków (bez przedrostka)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2223
msgid ""
"Input without the <literal>le:</literal> prefix is treated as a literal "
"string. WinMerge shows only lines that contain that string. Internally, the "
"input is equivalent to <literal>le:Line contains \"<replaceable>input</"
"replaceable>\"</literal>."
msgstr ""
"Wejście bez <literal>le:</literal> prefiks jest traktowany jako ciąg znaków. "
"WinMerge wyświetla tylko linie zawierające ten ciąg. Wewnętrznie dane "
"wejściowe są równoważne <literal>le:Line contains \"<replaceable>input</"
"replaceable>\"</literal>."

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2227
msgid ""
"Example: entering <userinput>TODO</userinput> shows all lines that contain "
"the text <literal>TODO</literal>."
msgstr ""
"Przykład: wejście <userinput>TODO</userinput> pokazuje wszystkie linie "
"zawierające tekst <literal>TODO</literal>."

#. type: Content of: <article><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2233
msgid "<literal>le:</literal> prefix (filter expression)"
msgstr "<literal>le:</literal> przedrostek (wyrażenie filtrujące)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2235
msgid ""
"If the input starts with <literal>le:</literal>, the remainder is "
"interpreted as a filter expression. The full expression syntax described in "
"<xref linkend=\"Filters_DisplayLineFilter_Syntax\"/> is available."
msgstr ""
"Jeśli dane wejściowe zaczynają się od <literal>le:</literal>, reszta jest "
"interpretowana jako wyrażenie filtrujące. Pełna składnia wyrażeń opisana w "
"<xref linkend=\"Filters_DisplayLineFilter_Syntax\"/> jest dostępny."

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2240
msgid ""
"Example: <userinput>le:Different and Line contains \"ERROR\"</userinput>"
msgstr ""
"Przykład: <userinput>le:Different and Line contains \"ERROR\"</userinput>"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><important><para>
#: English/Filters.xml:2243
msgid ""
"The <literal>le:</literal> prefix must appear at the very beginning of the "
"input. If it appears anywhere else, the entire input is treated as a plain "
"string."
msgstr ""
"The <literal>le:</literal> prefiks musi pojawić się na samym początku "
"wejścia. Jeśli pojawi się gdziekolwiek indziej, całe dane wejściowe są "
"traktowane jako zwykły ciąg znaków."

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><important><para>
#: English/Filters.xml:2246
msgid ""
"For example, <userinput>Hello or le:Line contains \"Hello\"</userinput> does "
"<emphasis>not</emphasis> contain a filter expression.  The whole input is "
"treated as a literal string search for the text <literal>Hello or le:Line "
"contains \"Hello\"</literal>."
msgstr ""
"Na przykład <userinput>Hello or le:Line contains \"Hello\"</userinput> robi "
"<emphasis>nie</emphasis> zawierają wyrażenie filtrujące.  Całość danych "
"wejściowych jest traktowana jako dosłowne wyszukiwanie ciągu znaków "
"<literal>Hello or le:Line contains \"Hello\"</literal>."

#. type: Content of: <article><section><section><title>
#: English/Filters.xml:2257
msgid "Filter expression syntax"
msgstr "Składnia wyrażenia filtrującego"

#. type: Content of: <article><section><section><para>
#: English/Filters.xml:2259
msgid ""
"Display line filter expressions use the same engine as folder compare filter "
"expressions (see <xref linkend=\"FilterExpression_Syntax\"/>), with the "
"following additional attributes and functions that operate on individual "
"lines."
msgstr ""
"Wyrażenia filtrów linii wyświetlania korzystają z tego samego silnika, co "
"wyrażenia filtrów porównywania folderów (zobacz <xref "
"linkend=\"FilterExpression_Syntax\"/>), z następującymi dodatkowymi "
"atrybutami i funkcjami działającymi na poszczególnych liniach."

#. type: Content of: <article><section><section><section><title>
#: English/Filters.xml:2265
msgid "Line attributes"
msgstr "Atrybuty linii"

#. type: Content of: <article><section><section><section><para>
#: English/Filters.xml:2267
msgid ""
"Attributes marked as supporting side-specific prefixes accept <literal>Left</"
"literal>, <literal>Middle</literal>, and <literal>Right</literal> prefixes "
"(e.g., <literal>LeftLine</literal>, <literal>RightLineLength</literal>).  "
"Attributes without a prefix evaluate across all panes."
msgstr ""
"Atrybuty oznaczone jako obsługujące przedrostki specyficzne dla strony są "
"akceptowane <literal>Left</literal>, <literal>Middle</literal>, i "
"<literal>Right</literal> przedrostki (np. <literal>LeftLine</literal>, "
"<literal>RightLineLength</literal>).  Atrybuty bez przedrostka są oceniane "
"we wszystkich okienkach."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2275
msgid "<varname>Line</varname>"
msgstr "<varname>Line</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2276
msgid ""
"Text content of the current line.  Supports side-specific prefixes.  "
"Example: <literal>Line contains \"TODO\"</literal>"
msgstr ""
"Treść tekstowa bieżącego wiersza.  Obsługuje prefiksy specyficzne dla "
"strony.  Przykład: <literal>Line contains \"TODO\"</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2281
msgid "<varname>LineLength</varname>"
msgstr "<varname>LineLength</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2282
msgid ""
"Length of the current line in characters.  Supports side-specific prefixes.  "
"Example: <literal>LineLength &gt; 120</literal>"
msgstr ""
"Długość bieżącej linii w znakach.  Obsługuje prefiksy specyficzne dla "
"strony.  Przykład: <literal>LineLength &gt; 120</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2287
msgid "<varname>LineNumber</varname>"
msgstr "<varname>LineNumber</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2288
msgid ""
"Real line number in the file (1-based), not counting ghost lines.  Supports "
"side-specific prefixes.  Example: <literal>LineNumber &lt;= 50</literal>"
msgstr ""
"Rzeczywisty numer linii w pliku (oparty na 1), nie licząc linii duchów.  "
"Obsługuje prefiksy specyficzne dla strony.  Przykład: <literal>LineNumber "
"&lt;= 50</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2294
msgid "<varname>ViewLineNumber</varname>"
msgstr "<varname>ViewLineNumber</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2295
msgid ""
"Display line number including ghost lines (1-based). Global attribute (no "
"side prefix).  Example: <literal>ViewLineNumber &lt;= 100</literal>"
msgstr ""
"Wyświetl numer linii, w tym linie widma (w oparciu o 1). Atrybut globalny "
"(bez bocznego przedrostka).  Przykład: <literal>ViewLineNumber &lt;= 100</"
"literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2301
msgid ""
"True if the line is part of a difference block.  Global attribute.  Example: "
"<literal>Different</literal>"
msgstr ""
"Prawda, jeśli linia jest częścią bloku różnicowego.  Atrybut globalny.  "
"Przykład: <literal>Different</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2307
msgid "True if the line is identical across all panes.  Global attribute."
msgstr ""
"Prawda, jeśli linia jest identyczna we wszystkich panelach.  Atrybut "
"globalny."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2311
msgid "<varname>Trivial</varname>"
msgstr "<varname>Trivial</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2312
msgid ""
"True if the line differs only in whitespace or other ignored content. Global "
"attribute.  Example: <literal>Different or Trivial</literal>"
msgstr ""
"Prawda, jeśli linia różni się jedynie odstępami lub inną ignorowaną treścią. "
"Atrybut globalny.  Przykład: <literal>Different or Trivial</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2318
msgid ""
"True if the line exists in the pane (not a ghost line). Supports side-"
"specific prefixes.  Example: <literal>LeftExists and not RightExists</"
"literal>"
msgstr ""
"Prawda, jeśli linia istnieje w panelu (nie jest to linia widmo). Obsługuje "
"prefiksy specyficzne dla strony.  Przykład: <literal>LeftExists and not "
"RightExists</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2323
msgid "<varname>Missing</varname>"
msgstr "<varname>Missing</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2324
msgid ""
"True if the line is a ghost line in the pane.  The opposite of "
"<varname>Exists</varname>.  Supports side-specific prefixes."
msgstr ""
"Prawda, jeśli linia jest linią widmową w okienku.  Przeciwieństwo "
"<varname>Exists</varname>.  Obsługuje prefiksy specyficzne dla strony."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2329
msgid "<varname>Moved</varname>"
msgstr "<varname>Moved</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2330
msgid ""
"True if the line is detected as a moved line.  Supports side-specific "
"prefixes."
msgstr ""
"Prawda, jeśli linia zostanie wykryta jako linia przesunięta.  Obsługuje "
"prefiksy specyficzne dla strony."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2334
msgid "<varname>Bookmarked</varname>"
msgstr "<varname>Bookmarked</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2335
msgid "True if the line has a bookmark.  Supports side-specific prefixes."
msgstr ""
"Prawda, jeśli linia ma zakładkę.  Obsługuje prefiksy specyficzne dla strony."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2339
msgid ""
"<varname>DifferentLeftMiddle</varname>, <varname>DifferentMiddleRight</"
"varname>, <varname>DifferentLeftRight</varname>"
msgstr ""
"<varname>DifferentLeftMiddle</varname>, <varname>DifferentMiddleRight</"
"varname>, <varname>DifferentLeftRight</varname>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2342
msgid ""
"True if the indicated pair of panes differs on this line. 3-way comparisons "
"only (except <varname>DifferentLeftRight</varname> which also works in 2-"
"way).  Global attributes.  Example: <literal>DifferentLeftMiddle and not "
"DifferentMiddleRight</literal>"
msgstr ""
"Prawda, jeśli wskazana para szyb różni się w tej linii. Tylko porównania "
"trójstronne (z wyjątkiem <varname>DifferentLeftRight</varname> który działa "
"również w trybie 2-kierunkowym).  Atrybuty globalne.  Przykład: "
"<literal>DifferentLeftMiddle and not DifferentMiddleRight</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2351
msgid ""
"End-of-line style for the current line as an integer value.  Supports side-"
"specific prefixes.  Values: 0 = None, 1 = LF, 2 = CR, 3 = CRLF Example: "
"<literal>le:EOL = 3</literal> shows only lines with CRLF endings"
msgstr ""
"Styl końca linii dla bieżącej linii jako wartość całkowita.  Obsługuje "
"prefiksy specyficzne dla strony.  Wartości: 0 = brak, 1 = LF, 2 = CR, 3 = "
"CRLF Przykład: <literal>le:EOL = 3</literal> pokazuje tylko linie z "
"zakończeniami CRLF"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2358
msgid ""
"End-of-line style for the current line as a string.  Supports side-specific "
"prefixes.  Values: \"None\", \"LF\", \"CR\", \"CRLF\" Example: <literal>le:"
"EOLStr = \"LF\"</literal> shows only lines with LF endings"
msgstr ""
"Styl końca linii dla bieżącej linii jako ciąg.  Obsługuje prefiksy "
"specyficzne dla strony.  Wartości: „Brak”, „LF”, „CR”, „CRLF” Przykład: "
"<literal>le:EOLStr = \"LF\"</literal> pokazuje tylko linie z zakończeniami LF"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2364
msgid ""
"<varname>Column</varname>, <varname>ColumnCount</varname> (table mode only)"
msgstr ""
"<varname>Column</varname>, <varname>ColumnCount</varname> (tylko tryb tabeli)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2366
msgid ""
"Cell content and column count in CSV/table mode.  Support side-specific "
"prefixes.  Example: <literal>Column(\"Status\") = \"FAIL\"</literal>"
msgstr ""
"Zawartość komórek i liczba kolumn w trybie CSV/tabeli.  Obsługa prefiksów "
"specyficznych dla strony.  Przykład: <literal>Column(\"Status\") = \"FAIL\"</"
"literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2371
msgid ""
"<function>LineAt</function>(<replaceable>lineNumber</replaceable>), "
"<function>LineOffsetAt</function>(<replaceable>offset</replaceable>)"
msgstr ""
"<function>LineAt</function>(<replaceable>lineNumber</replaceable>), "
"<function>LineOffsetAt</function>(<replaceable>offset</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2373
msgid ""
"Text of the line at an absolute line number or at a relative offset from the "
"current line.  Supports side-specific prefix functions.  Example: "
"<literal>le:Different and RightLineOffsetAt(-1) matches \"^//\"</literal>"
msgstr ""
"Tekst linii pod bezwzględnym numerem linii lub względnym przesunięciem od "
"bieżącej linii.  Obsługuje funkcje prefiksów specyficzne dla strony.  "
"Przykład: <literal>le:Different and RightLineOffsetAt(-1) matches \"^//\"</"
"literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2380
msgid ""
"<function>Column</function>(<replaceable>indexOrName</replaceable>), "
"<function>ColumnRange</function>(<replaceable>specification</replaceable>), "
"<function>ColumnAt</function>(<replaceable>line</replaceable>, "
"<replaceable>indexOrName</replaceable>), <function>ColumnOffsetAt</"
"function>(<replaceable>offset</replaceable>, <replaceable>indexOrName</"
"replaceable>)  (table mode only)"
msgstr ""
"<function>Column</function>(<replaceable>indexOrName</replaceable>), "
"<function>ColumnRange</function>(<replaceable>specification</replaceable>), "
"<function>ColumnAt</function>(<replaceable>line</replaceable>, "
"<replaceable>indexOrName</replaceable>), <function>ColumnOffsetAt</"
"function>(<replaceable>offset</replaceable>, <replaceable>indexOrName</"
"replaceable>) (tylko tryb tabeli)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2385
msgid ""
"Cell content by index or name, at the current, absolute, or relative line. "
"For <function>Column</function>, a numeric string is always treated as a "
"column name. A numeric argument is a 1-based column index. Use "
"<function>ColumnRange</function> to specify multiple columns and ranges "
"using comma-separated <literal>N</literal>, <literal>N-M</literal>, and "
"<literal>N-</literal> items; whitespace is ignored, for example "
"<literal>ColumnRange(\"1, 3, 5-10, 13-\")</literal>.  Prefix a range with "
"<literal>!</literal> to exclude it; for example <literal>ColumnRange(\"!"
"1\")</literal> excludes column 1 and <literal>ColumnRange(\"1-10,!4-5\")</"
"literal> selects columns 1-10 except columns 4-5. If no included range is "
"specified, all columns are included before exclusions are applied.  Existing "
"name and single-index forms return one cell; range forms return the selected "
"cell values joined using the table delimiter.  Example: <literal>le:"
"RightColumn(\"Category\") != ColumnOffsetAt(-1, \"Category\")</literal>"
msgstr ""
"Zawartość komórki według indeksu lub nazwy, w linii bieżącej, bezwzględnej "
"lub względnej. Dla <function>Column</function>, ciąg liczbowy jest zawsze "
"traktowany jako nazwa kolumny. Argument numeryczny to indeks kolumny oparty "
"na 1. Użyj <function>ColumnRange</function> aby określić wiele kolumn i "
"zakresów, oddzielając je przecinkami <literal>N</literal>, <literal>N-M</"
"literal>, i <literal>N-</literal> przedmioty; białe znaki są ignorowane, na "
"przykład <literal>ColumnRange(\"1, 3, 5-10, 13-\")</literal>.  Poprzedź "
"zakres znakiem <literal>!</literal> aby to wykluczyć; na przykład "
"<literal>ColumnRange(\"!1\")</literal> wyklucza kolumnę 1 i "
"<literal>ColumnRange(\"1-10,!4-5\")</literal> wybiera kolumny 1-10 z "
"wyjątkiem kolumn 4-5. Jeśli nie określono zakresu uwzględnionego, wszystkie "
"kolumny zostaną uwzględnione przed zastosowaniem wykluczeń.  Istniejące "
"formy nazw i formularze z pojedynczym indeksem zwracają jedną komórkę; "
"formularze zakresów zwracają wartości wybranych komórek połączone za pomocą "
"ogranicznika tabeli.  Przykład: <literal>le:RightColumn(\"Category\") != "
"ColumnOffsetAt(-1, \"Category\")</literal>"

#. type: Content of: <article><section><section><section><title>
#: English/Filters.xml:2406
msgid "Line functions"
msgstr "Funkcje liniowe"

#. type: Content of: <article><section><section><section><para>
#: English/Filters.xml:2409
msgid ""
"Display line filter expressions can also use functions described in <xref "
"linkend=\"FilterExpression_Functions\"/>."
msgstr ""
"Wyrażenia filtru linii wyświetlania mogą również korzystać z funkcji "
"opisanych w <xref linkend=\"FilterExpression_Functions\"/>."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2415
msgid ""
"<function>matchContext</function>(<replaceable>expr</replaceable>, "
"<replaceable>linesBefore</replaceable>, <replaceable>linesAfter</"
"replaceable>)"
msgstr ""
"<function>matchContext</function>(<replaceable>expr</replaceable>, "
"<replaceable>linesBefore</replaceable>, <replaceable>linesAfter</"
"replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2418
msgid ""
"True if the current line is within <replaceable>linesBefore</replaceable> "
"lines before or <replaceable>linesAfter</replaceable> lines after any line "
"matching <replaceable>expr</replaceable>.  Example: <literal>le:"
"matchContext(Different, 3, 3)</literal>"
msgstr ""
"Prawda, jeśli bieżąca linia znajduje się w obrębie <replaceable>linesBefore</"
"replaceable> linie przed lub <replaceable>linesAfter</replaceable> linie po "
"dowolnym dopasowaniu linii <replaceable>expr</replaceable>.  Przykład: "
"<literal>le:matchContext(Different, 3, 3)</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2425
msgid "<function>matchNumber</function>(<replaceable>expr</replaceable>)"
msgstr "<function>matchNumber</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2426
msgid ""
"1-based index of the current line within all matching lines. Returns "
"<literal>none</literal>if the line does not match.  Example: <literal>le:"
"matchNumber(Different) = 1</literal> shows only the first line that matches "
"(the first difference line)."
msgstr ""
"Indeks bieżącego wiersza oparty na liczbie 1 we wszystkich pasujących "
"wierszach. Powroty <literal>none</literal>jeśli linia nie pasuje.  Przykład: "
"<literal>le:matchNumber(Different) = 1</literal> pokazuje tylko pierwszą "
"pasującą linię (pierwszą linię różnicową)."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2432
msgid "<function>matchCount</function>(<replaceable>expr</replaceable>)"
msgstr "<function>matchCount</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2433
msgid ""
"Total number of lines matching <replaceable>expr</replaceable> across the "
"whole file.  Example: <literal>le:matchNumber(Different) = "
"matchCount(Different)</literal> shows only the last line that matches (the "
"last difference line)."
msgstr ""
"Łączna liczba pasujących linii <replaceable>expr</replaceable> w całym "
"pliku.  Przykład: <literal>le:matchNumber(Different) = "
"matchCount(Different)</literal> pokazuje tylko ostatnią pasującą linię "
"(ostatnią linię różnicową)."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2439
msgid "<function>matchBlockNumber</function>(<replaceable>expr</replaceable>)"
msgstr "<function>matchBlockNumber</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2440
msgid ""
"Returns the 1-based block number of the matching block containing the "
"current line. Returns <literal>none</literal> if the current line is not in "
"any matching block.  Example: <literal>le:matchBlockNumber(Different) = 1</"
"literal> shows only lines in the first difference block."
msgstr ""
"Zwraca numer bloku odpowiadającego liczbie 1 zawierającego bieżący wiersz. "
"Powroty <literal>none</literal> jeśli bieżąca linia nie znajduje się w "
"żadnym pasującym bloku.  Przykład: <literal>le:matchBlockNumber(Different) = "
"1</literal> pokazuje tylko linie w pierwszym bloku różnicowym."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2447
msgid "<function>matchBlockOffset</function>(<replaceable>expr</replaceable>)"
msgstr "<function>matchBlockOffset</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2448
msgid ""
"Returns the 1-based offset of the current line within the matching block. "
"Returns <literal>none</literal> if the current line is not in any matching "
"block.  Example: <literal>le:matchBlockOffset(Different) = 1</literal> shows "
"only the first line of each difference block."
msgstr ""
"Zwraca przesunięcie bieżącej linii w pasującym bloku w oparciu o 1. Powroty "
"<literal>none</literal> jeśli bieżąca linia nie znajduje się w żadnym "
"pasującym bloku.  Przykład: <literal>le:matchBlockOffset(Different) = 1</"
"literal> pokazuje tylko pierwszą linię każdego bloku różnicowego."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2455
msgid "<function>matchBlockSize</function>(<replaceable>expr</replaceable>)"
msgstr "<function>matchBlockSize</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2456
msgid ""
"Returns the size (number of lines) of the matching block containing the "
"current line. Returns <literal>none</literal> if the current line is not in "
"any matching block.  Example: <literal>le:matchBlockSize(Different) &gt; 5</"
"literal> shows only lines in difference blocks larger than 5 lines."
msgstr ""
"Zwraca rozmiar (liczbę linii) pasującego bloku zawierającego bieżącą linię. "
"Powroty <literal>none</literal> jeśli bieżąca linia nie znajduje się w "
"żadnym pasującym bloku.  Przykład: <literal>le:matchBlockSize(Different) "
"&gt; 5</literal> pokazuje tylko linie w blokach różnicowych większych niż 5 "
"linii."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2463
msgid "<function>matchBlockCount</function>(<replaceable>expr</replaceable>)"
msgstr "<function>matchBlockCount</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2464
msgid ""
"Total number of matching blocks in the file.  Example: <literal>le:"
"matchBlockNumber(Different) = matchBlockCount(Different)</literal> shows "
"only lines in the last difference block."
msgstr ""
"Całkowita liczba pasujących bloków w pliku.  Przykład: <literal>le:"
"matchBlockNumber(Different) = matchBlockCount(Different)</literal> pokazuje "
"tylko linie w ostatnim bloku różnicowym."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2469
msgid ""
"<function>matchDistance</function>(<replaceable>expr</replaceable>), "
"<function>matchDistanceBefore</function>(<replaceable>expr</replaceable>), "
"<function>matchDistanceAfter</function>(<replaceable>expr</replaceable>)"
msgstr ""
"<function>matchDistance</function>(<replaceable>expr</replaceable>), "
"<function>matchDistanceBefore</function>(<replaceable>expr</replaceable>), "
"<function>matchDistanceAfter</function>(<replaceable>expr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2472
msgid ""
"Distance in lines to the nearest matching range (both directions, before "
"only, or after only).  Example: <literal>le:matchDistance(Different) &lt;= "
"5</literal>"
msgstr ""
"Odległość w liniach do najbliższego pasującego zakresu (w obu kierunkach, "
"tylko przed lub tylko po).  Przykład: <literal>le:matchDistance(Different) "
"&lt;= 5</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2477
msgid ""
"<function>matchInside</function>(<replaceable>beginExpr</replaceable>, "
"<replaceable>endExpr</replaceable>)"
msgstr ""
"<function>matchInside</function>(<replaceable>beginExpr</replaceable>, "
"<replaceable>endExpr</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2479
msgid ""
"True if the current line falls between a line matching "
"<replaceable>beginExpr</replaceable> and the next line matching "
"<replaceable>endExpr</replaceable> (inclusive).  Example: <literal>le:"
"matchInside(Line matches \"^#ifdef\", Line matches \"^#endif\")</literal>"
msgstr ""
"Prawda, jeśli bieżąca linia mieści się w pasującym wierszu "
"<replaceable>beginExpr</replaceable> i dopasowanie następnej linii "
"<replaceable>endExpr</replaceable> (włącznie).  Przykład: <literal>le:"
"matchInside(Line matches \"^#ifdef\", Line matches \"^#endif\")</literal>"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2486
msgid ""
"<function>average</function>(<replaceable>expr</replaceable>), "
"<function>average</function>(<replaceable>expr</replaceable>, "
"<replaceable>condition</replaceable>)"
msgstr ""
"<function>average</function>(<replaceable>expr</replaceable>), "
"<function>average</function>(<replaceable>expr</replaceable>, "
"<replaceable>condition</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2488
msgid ""
"Calculates the average (arithmetic mean) of numeric values produced by "
"evaluating <replaceable>expr</replaceable> for all lines in the file.  If "
"<replaceable>condition</replaceable> is provided, only lines where "
"<replaceable>condition</replaceable> evaluates to true are included in the "
"calculation.  Non-numeric results are ignored. Returns <literal>none</"
"literal>if no numeric values are found.  Example: <literal>le:"
"toInt(Column(\"Price\")) &gt; average(toInt(Column(\"Price\")))</literal> "
"shows rows where the price exceeds the average price.  Example with "
"condition: <literal>le:average(toInt(Column(\"Score\")), Column(\"Status\") "
"= \"PASS\")</literal> calculates the average score for rows with status "
"\"PASS\"."
msgstr ""
"Oblicza średnią (średnią arytmetyczną) wartości liczbowych uzyskanych w "
"wyniku oceny <replaceable>expr</replaceable> dla wszystkich linii w pliku.  "
"Jeśli <replaceable>condition</replaceable> jest podane, tylko linie gdzie "
"<replaceable>condition</replaceable> wartości true są uwzględniane w "
"obliczeniach.  Wyniki inne niż numeryczne są ignorowane. Powroty "
"<literal>none</literal>jeśli nie zostaną znalezione żadne wartości "
"liczbowe.  Przykład: <literal>le:toInt(Column(\"Price\")) &gt; "
"average(toInt(Column(\"Price\")))</literal> pokazuje wiersze, w których cena "
"przekracza cenę średnią.  Przykład z warunkiem: <literal>le:"
"average(toInt(Column(\"Score\")), Column(\"Status\") = \"PASS\")</literal> "
"oblicza średni wynik dla wierszy ze statusem „PASS”."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2500
msgid ""
"<function>maximum</function>(<replaceable>expr</replaceable>), "
"<function>maximum</function>(<replaceable>expr</replaceable>, "
"<replaceable>condition</replaceable>)"
msgstr ""
"<function>maximum</function>(<replaceable>expr</replaceable>), "
"<function>maximum</function>(<replaceable>expr</replaceable>, "
"<replaceable>condition</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2502
msgid ""
"Returns the maximum value among all results produced by evaluating "
"<replaceable>expr</replaceable> for all lines in the file.  If "
"<replaceable>condition</replaceable> is provided, only lines where "
"<replaceable>condition</replaceable> evaluates to true are considered.  "
"Works with numeric values, strings (alphabetical comparison), and "
"timestamps.  Returns <literal>none</literal>if no values are found.  "
"Example: <literal>le:toInt(Column(\"Quantity\")) = "
"maximum(toInt(Column(\"Quantity\")))</literal> shows rows with the highest "
"quantity."
msgstr ""
"Zwraca maksymalną wartość spośród wszystkich wyników uzyskanych w wyniku "
"oceny <replaceable>expr</replaceable> dla wszystkich linii w pliku.  Jeśli "
"<replaceable>condition</replaceable> jest podane, tylko linie gdzie "
"<replaceable>condition</replaceable> brane jest pod uwagę, że ma wartość "
"true.  Działa z wartościami numerycznymi, ciągami znaków (porównanie "
"alfabetyczne) i znacznikami czasu.  Powroty <literal>none</literal>jeśli nie "
"zostaną znalezione żadne wartości.  Przykład: <literal>le:"
"toInt(Column(\"Quantity\")) = maximum(toInt(Column(\"Quantity\")))</literal> "
"pokazuje wiersze z największą liczbą."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2513
msgid ""
"<function>minimum</function>(<replaceable>expr</replaceable>), "
"<function>minimum</function>(<replaceable>expr</replaceable>, "
"<replaceable>condition</replaceable>)"
msgstr ""
"<function>minimum</function>(<replaceable>expr</replaceable>), "
"<function>minimum</function>(<replaceable>expr</replaceable>, "
"<replaceable>condition</replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2515
msgid ""
"Returns the minimum value among all results produced by evaluating "
"<replaceable>expr</replaceable> for all lines in the file.  If "
"<replaceable>condition</replaceable> is provided, only lines where "
"<replaceable>condition</replaceable> evaluates to true are considered.  "
"Works with numeric values, strings (alphabetical comparison), and "
"timestamps.  Returns <literal>none</literal>if no values are found.  "
"Example: <literal>le:Column(\"Status\") = minimum(Column(\"Status\"))</"
"literal> shows rows with the alphabetically first status value."
msgstr ""
"Zwraca minimalną wartość spośród wszystkich wyników uzyskanych w wyniku "
"oceny <replaceable>expr</replaceable> dla wszystkich linii w pliku.  Jeśli "
"<replaceable>condition</replaceable> jest podane, tylko linie gdzie "
"<replaceable>condition</replaceable> brane jest pod uwagę, że ma wartość "
"true.  Działa z wartościami numerycznymi, ciągami znaków (porównanie "
"alfabetyczne) i znacznikami czasu.  Powroty <literal>none</literal>jeśli nie "
"zostaną znalezione żadne wartości.  Przykład: <literal>le:Column(\"Status\") "
"= minimum(Column(\"Status\"))</literal> pokazuje wiersze z alfabetycznie "
"pierwszą wartością statusu."

#. type: Content of: <article><section><section><section><variablelist><varlistentry><term>
#: English/Filters.xml:2526
msgid ""
"<function>sum</function>(<replaceable>expr</replaceable>), <function>sum</"
"function>(<replaceable>expr</replaceable>, <replaceable>condition</"
"replaceable>)"
msgstr ""
"<function>sum</function>(<replaceable>expr</replaceable>), <function>sum</"
"function>(<replaceable>expr</replaceable>, <replaceable>condition</"
"replaceable>)"

#. type: Content of: <article><section><section><section><variablelist><varlistentry><listitem><para>
#: English/Filters.xml:2528
msgid ""
"Calculates the sum of all numeric values produced by evaluating "
"<replaceable>expr</replaceable> for all lines in the file.  If "
"<replaceable>condition</replaceable> is provided, only lines where "
"<replaceable>condition</replaceable> evaluates to true are included in the "
"calculation.  Non-numeric results are ignored. Returns <literal>none</"
"literal>if no numeric values are found.  Example: <literal>le:"
"toInt(Column(\"Quantity\")) / sum(toInt(Column(\"Quantity\"))) * 100</"
"literal> calculates each row's percentage of the total quantity.  Example "
"with condition: <literal>le:sum(toInt(Column(\"Sales\")), Column(\"Region\") "
"= \"East\")</literal> calculates total sales for the \"East\" region."
msgstr ""
"Oblicza sumę wszystkich wartości liczbowych uzyskanych w wyniku oceny "
"<replaceable>expr</replaceable> dla wszystkich linii w pliku.  Jeśli "
"<replaceable>condition</replaceable> jest podane, tylko linie gdzie "
"<replaceable>condition</replaceable> wartości true są uwzględniane w "
"obliczeniach.  Wyniki inne niż numeryczne są ignorowane. Powroty "
"<literal>none</literal>jeśli nie zostaną znalezione żadne wartości "
"liczbowe.  Przykład: <literal>le:toInt(Column(\"Quantity\")) / "
"sum(toInt(Column(\"Quantity\"))) * 100</literal> oblicza procent każdego "
"wiersza całkowitej ilości.  Przykład z warunkiem: <literal>le:"
"sum(toInt(Column(\"Sales\")), Column(\"Region\") = \"East\")</literal> "
"oblicza całkowitą sprzedaż dla regionu „Wschód”."

