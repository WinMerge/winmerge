#: English/Plugins.xml:2393
msgid "Replace plugin file"
msgstr "Zastąp plik wtyczki"

#. type: Content of: <article><section><section><title>
#: English/Plugins.xml:2392
msgid "<filename>Replace<placeholder type=\"indexterm\" id=\"0\"/></filename>"
msgstr "<filename>Replace<placeholder type=\"indexterm\" id=\"0\"/></filename>"

#. type: Content of: <article><section><section><para>
#: English/Plugins.xml:2396
msgid "Replaces text with another text"
msgstr "Zastępuje tekst innym tekstem"

#. type: Content of: <article><section><section><cmdsynopsis>
#: English/Plugins.xml:2399
msgid ""
"<command>Replace</command> <arg><option>-i</option></arg> <arg><option>-e</"
