msgid "choosing files and folders"
msgstr "wybieranie plików i folderów"

#. type: Content of: <article><section><title><indexterm><secondary>
#: English/Quick_start.xml:11 English/Quick_start.xml:241
#: English/Quick_start.xml:245 English/Quick_start.xml:327
