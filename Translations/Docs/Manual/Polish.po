msgid "<option><replaceable>text_to_replace</replaceable></option>"
msgstr "<option><replaceable>text_to_replace</replaceable></option>"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Plugins.xml:2423
msgid "text to replace"
msgstr "tekst do zastąpienia"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Plugins.xml:2430
msgid "ignore case (only for -e)"
msgstr "zignoruj wielkość liter (tylko dla -e)"

#. type: Content of: <article><section><section><variablelist><varlistentry><listitem><para>
#: English/Plugins.xml:2437
msgid "treat the specified text as a regular expression"
msgstr "potraktuj określony tekst jako wyrażenie regularne"

#. type: Content of: <article><section><section><title><filename><indexterm><primary>
#: English/Plugins.xml:2475
msgid "Tokenize plugin file"
msgstr "Tokenizuj plik wtyczki"

